<!doctype html>
<html lang="ko">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>실시간 제보 - 모여봄</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>

<body>

  <%- include('../partials/header') %>

  <main class="container my-4">

    <section class="hero p-5 mb-4">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <h1 class="display-5 mb-3">실시간 제보</h1>
          <p class="lead">지금 이 순간 현장의 혼잡도·주차·날씨 정보를 공유해주세요</p>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
          <div style="font-size:100px;">📡</div>
        </div>
      </div>
    </section>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <h5 class="mb-0">📡 실시간 제보 피드</h5>
      <a href="/feed/write" class="btn btn-brand">✏️ 제보하기</a>
    </div>

    <div class="row g-4">

      <div class="col-lg-8">
        <div class="row g-3">
          <% if(feeds.length===0) { %>
          <div class="col-12 text-center py-5">
            <p class="text-muted">아직 제보가 없습니다. 첫 제보를 남겨보세요!</p>
          </div>
          <% } %>

          <% feeds.forEach(feed => { %>
          <div class="col-12">
            <div class="card shadow-sm">
              <% if(feed.image) { %>
              <img src="/images/upload/<%= feed.image %>" class="card-img-top" alt="제보 이미지"
                style="height: 200px; object-fit: cover;">
              <% } %>
              <div class="card-body">
                <div class="d-flex align-items-center mb-2 gap-2">
                  <span><%= feed.author ? feed.author.avatar_emoji : '😊' %></span>
                  <span class="fw-bold small"><%= feed.author ? feed.author.nickname : '알 수 없음' %></span>
                  <span class="ms-auto text-muted small"><%= new Date(feed.createdAt).toLocaleString() %></span>
                </div>
                <p class="mb-2 text-truncate"><%= feed.content %></p>
                <div class="d-flex justify-content-between align-items-center">
                  <div class="d-flex gap-2 align-items-center">
                    <span class="tag-soft">📍 <%= feed.locationTag %></span>
                    <% if(feed.category) { %><span class="badge bg-secondary"><%= feed.category %></span><% } %>
                  </div>
                  <a href="/feed/info/<%= feed._id %>" class="btn btn-sm btn-outline-brand">상세보기</a>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>

        <% if(totalPages > 1) { %>
        <nav class="mt-4">
          <ul class="pagination justify-content-center">
            <% for(let i=1; i<=totalPages; i++) { %>
            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
              <a class="page-link" href="/feed/list?page=<%= i %>"><%= i %></a>
            </li>
            <% } %>
          </ul>
        </nav>
        <% } %>
      </div>

      <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
          <div class="card-body">
            <h6 class="card-title mb-3">🔥 최근 제보 지역</h6>
            <ul class="list-group list-group-flush">
              <%
                const placeCounts = {};
                feeds.forEach(f => { placeCounts[f.locationTag] = (placeCounts[f.locationTag] || 0) + 1; });
                const sortedPlaces = Object.entries(placeCounts).sort((a, b) => b[1] - a[1]).slice(0, 5);
              %>
              <% if(sortedPlaces.length === 0) { %>
              <li class="list-group-item px-0 text-muted">최근 제보가 없습니다.</li>
              <% } %>
              <% sortedPlaces.forEach(([place, count], i) => { %>
              <li class="list-group-item px-0 d-flex justify-content-between">
                <span><strong><%= i + 1 %></strong> <%= place %></span>
                <span class="fw-bold"><%= count %>건</span>
              </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="card-title mb-3">📢 제보 안내</h6>
            <p class="small text-muted mb-2">제보는 목록과 상세 페이지에 반영됩니다.</p>
            <p class="small text-muted mb-0">📍 제보 시 장소 태그는 필수입니다.</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
