<!doctype html>
<html lang="ko">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>제보하기 - 모여봄</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>

<body>

  <%- include('../partials/header') %>

  <main class="container my-4">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h4 class="mb-1">📡 실시간 제보하기</h4>
            <p class="text-muted small mb-4">제보한 내용은 실시간 제보 목록에 반영됩니다.</p>

            <form action="/feed/write" method="post" enctype="multipart/form-data">
              <% if (prePlace) { %>
                <input type="hidden" name="place_id" value="<%= prePlace.id %>">
                <input type="hidden" name="place_name" value="<%= prePlace.name %>">
                <input type="hidden" name="locationTag" value="<%= prePlace.name %>">
                <div class="mb-3">
                  <label class="form-label">📍 장소 태그</label>
                  <div class="form-control bg-light text-muted d-flex align-items-center gap-2">
                    <span>📍</span> <strong><%= prePlace.name %></strong>
                    <span class="ms-2 badge bg-secondary">이 장소 기준 제보</span>
                  </div>
                </div>
              <% } else { %>
                <input type="hidden" name="place_id" id="place_id">
                <input type="hidden" name="place_name" id="place_name">
                <input type="hidden" name="locationTag" id="locationTag">

              <div class="mb-3">
                <label class="form-label">📍 장소 선택 <span class="text-danger">* 필수</span></label>
              <div id="map" style="width:100%; height:300px; margin-bottom:10px;"></div>

                <input type="text" id="selected_place" class="form-control" placeholder="지도에서 장소를 선택하세요" readonly required>

              <div id="markerInfo" data-markers='<%- JSON.stringify(markerInfo) %>'></div>
              </div>
               <% } %>

              <div class="mb-3">
                <label for="category" class="form-label">카테고리 <span class="text-danger">*</span></label>
                <select id="category" name="category" class="form-select" required>
                  <option value="">카테고리를 선택하세요</option>
                  <option value="혼잡도">혼잡도</option>
                  <option value="주차">주차</option>
                  <option value="맛집">맛집</option>
                  <option value="날씨">날씨</option>
                  <option value="기타">기타</option>
                </select>
              </div>

              <div class="mb-3">
                <label for="content" class="form-label">내용 <span class="text-danger">*</span></label>
                <textarea id="content" name="content" class="form-control" rows="5"
                  placeholder="현재 장소의 분위기, 혼잡도 등을 공유해주세요" required></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">사진 첨부</label>
                <input type="file" name="uploadFile" class="form-control" accept="image/*" />
              </div>

              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-brand btn-lg">제보 등록</button>
                <% if (prePlace) { %>
                  <a href="javascript:history.back()" class="btn btn-outline-secondary">취소</a>
                <% } else { %>
                  <a href="/feed/list" class="btn btn-outline-secondary">취소</a>
                <% } %>
              </div>
            </form>

          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script type="text/javascript" src="//dapi.kakao.com/v2/maps/sdk.js?appkey=<%= process.env.KAKAO_MAP_API %>"></script>
<script>
  const markerDataDiv = document.getElementById('markerInfo');
  if (markerDataDiv) {
    const markerData = JSON.parse(markerDataDiv.dataset.markers);
    const mapContainer = document.getElementById('map');
    const mapOption = {
      center: new kakao.maps.LatLng(37.5665, 126.9780),
      level: 8
    };
    const map = new kakao.maps.Map(mapContainer, mapOption);
    const imageSize = new kakao.maps.Size(35, 35);
    markerData.forEach((p) => {
      let mkImg = "/images/marker_available.png";
      if (p.congest_lvl === '혼잡') {
        mkImg = "/images/marker_crowdede.png";
      } else if (p.congest_lvl === '약간 붐빔') {
        mkImg = "/images/marker_little_crowded.png";
      } else if (p.congest_lvl === '보통') {
        mkImg = "/images/marker_normal.png";
      }
      const markerImage = new kakao.maps.MarkerImage(mkImg, imageSize);
      const marker = new kakao.maps.Marker({
        map: map,
        position: new kakao.maps.LatLng(p.latitude, p.longitude),
        title: p.name,
        image: markerImage
      });
      kakao.maps.event.addListener(marker, 'click', function () {
        document.getElementById('place_id').value = p.name;
        document.getElementById('place_name').value = p.name;
        document.getElementById('locationTag').value = p.name;
        document.getElementById('selected_place').value = p.name;
        alert(p.name + ' 장소가 선택되었습니다.');
      });
    });
  }
</script>
</body>
</html>
