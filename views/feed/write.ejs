<!doctype html>
<html lang="ko">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>제보하기 - 모여봄</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>

<body>

  <%- include('../partials/header') %>

  <main class="container my-4">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h4 class="mb-1">📡 실시간 제보하기</h4>
            <p class="text-muted small mb-4">제보한 내용은 실시간 제보 목록에 반영됩니다.</p>

            <form action="/feed/write" method="post" enctype="multipart/form-data">
              <% if (prePlace) { %>
                <input type="hidden" name="place_id" value="<%= prePlace.id %>">
                <input type="hidden" name="place_name" value="<%= prePlace.name %>">
                <input type="hidden" name="locationTag" value="<%= prePlace.name %>">
                <div class="mb-3">
                  <label class="form-label">📍 장소 태그</label>
                  <div class="form-control bg-light text-muted d-flex align-items-center gap-2">
                    <span>📍</span> <strong><%= prePlace.name %></strong>
                    <span class="ms-2 badge bg-secondary">이 장소 기준 제보</span>
                  </div>
                </div>
              <% } else { %>
                <input type="hidden" name="place_name" id="place_name">
                <input type="hidden" name="locationTag" id="locationTag">
                <div class="mb-3">
                  <label for="place_id" class="form-label">📍 장소 태그 <span class="text-danger">* 필수</span></label>
                  <select id="place_id" name="place_id" class="form-select" required onchange="syncPlace(this)">
                    <option value="">장소를 선택하세요</option>
                    <option value="연남동">연남동 (마포구)</option>
                    <option value="북촌">북촌 (종로구)</option>
                    <option value="강남역">강남역 (강남구)</option>
                    <option value="서래마을">서래마을 (서초구)</option>
                    <option value="잠실">잠실 (송파구)</option>
                    <option value="서울숲">서울숲 (성동구)</option>
                    <option value="성수동">성수동 (성동구)</option>
                    <option value="익선동">익선동 (종로구)</option>
                  </select>
                </div>
              <% } %>

              <div class="mb-3">
                <label for="content" class="form-label">내용 <span class="text-danger">*</span></label>
                <textarea id="content" name="content" class="form-control" rows="5"
                  placeholder="현재 장소의 분위기, 혼잡도 등을 공유해주세요" required></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label">사진 첨부</label>
                <input type="file" name="uploadFile" class="form-control" accept="image/*" />
              </div>

              <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" name="gps_verified" value="true" id="gpsChk">
                <label class="form-check-label" for="gpsChk">현재 위치 GPS 인증</label>
              </div>

              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-brand btn-lg">제보 등록</button>
                <% if (prePlace) { %>
                  <a href="javascript:history.back()" class="btn btn-outline-secondary">취소</a>
                <% } else { %>
                  <a href="/feed/list" class="btn btn-outline-secondary">취소</a>
                <% } %>
              </div>
            </form>

          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function syncPlace(sel) {
      const val = sel.value;
      document.getElementById('place_name').value = val;
      document.getElementById('locationTag').value = val;
    }
  </script>

</body>

</html>
