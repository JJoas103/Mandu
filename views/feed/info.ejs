<!doctype html>
<html lang="ko">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>장소 상세 - 모여봄</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>

<body>

  <!-- 헤더 -->
  <%- include('../partials/header') %>
    <main class="container my-4">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm mb-4">
            <% if(feed.image) { %>
              <img src="/images/upload/<%= feed.image %>" class="card-img-top" alt="제보 이미지">
              <% } %>
                <div class="card-body">
                  <div class="d-flex align-items-center mb-3">
                    <span class="fs-2 me-2">
                      <%= feed.author ? feed.author.avatar_emoji : '😊' %>
                    </span>
                    <div>
                      <div class="fw-bold">
                        <%= feed.author ? feed.author.nickname : '알 수 없음' %>
                      </div>
                      <div class="text-muted small">
                        📍 <%= feed.locationTag %>
                        <% if(feed.category) { %> · <span class="badge bg-secondary"><%= feed.category %></span><% } %>
                        · <%= new Date(feed.createdAt).toLocaleString() %>
                      </div>
                    </div>
                    <% if(user && feed.author && user.id===feed.author._id.toString()) { %>
                      <div class="ms-auto">
                        <a href="/feed/modify/<%= feed._id %>" class="btn btn-sm btn-outline-secondary">수정</a>
                        <form action="/feed/delete/<%= feed._id %>" method="post" class="d-inline"
                          onsubmit="return confirm('정말 삭제하시겠습니까?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger">삭제</button>
                        </form>
                      </div>
                      <% } %>
                  </div>
                  <p class="fs-5">
                    <%= feed.content %>
                  </p>
                </div>
          </div>

          <!-- 댓글 섹션 -->
          <div class="card shadow-sm">
            <div class="card-body">
              <h6 class="mb-3">댓글</h6>

              <% if(user) { %>
                <form action="/comment/write" method="post" class="mb-4">
                  <input type="hidden" name="boardId" value="<%= feed._id %>">
                  <input type="hidden" name="onModel" value="Feed">
                  <div class="input-group">
                    <textarea name="content" class="form-control" placeholder="댓글을 남겨보세요" rows="2" required></textarea>
                    <button type="submit" class="btn btn-brand">등록</button>
                  </div>
                </form>
                <% } %>

                  <ul class="list-group list-group-flush">
                    <% if(comments.length===0) { %>
                      <li class="list-group-item text-center text-muted py-3">첫 댓글을 남겨보세요!</li>
                      <% } %>
                        <% comments.forEach(comment=> { %>
                          <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between mb-1">
                              <span class="fw-bold small">
                                <%= comment.author ? comment.author.avatar_emoji : '😊' %>
                                  <%= comment.author ? comment.author.nickname : '알 수 없음' %>
                              </span>
                              <span class="text-muted small">
                                <%= new Date(comment.createdAt).toLocaleString() %>
                              </span>
                            </div>
                            <p class="mb-1">
                              <%= comment.content %>
                            </p>
                            <% if(user && comment.author && user.id===comment.author._id.toString()) { %>
                              <form action="/comment/delete" method="post" class="text-end">
                                <input type="hidden" name="commentId" value="<%= comment._id %>">
                                <input type="hidden" name="boardId" value="<%= feed._id %>">
                                <input type="hidden" name="onModel" value="Feed">
                                <button type="submit"
                                  class="btn btn-link btn-sm text-danger p-0 text-decoration-none">삭제</button>
                              </form>
                              <% } %>
                          </li>
                          <% }) %>
                  </ul>
            </div>
          </div>
          <div class="mt-3">
            <a href="/feed/list" class="btn btn-outline-secondary">목록으로</a>
          </div>
        </div>
      </div>
    </main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>