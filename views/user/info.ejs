<!doctype html>
<html lang="ko">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>회원정보</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>

<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<main class="container my-4">
		<div class="card shadow-sm mb-4">
			<div class="card-body text-center">
				<% if(user.provider === 'google' || user.provider === 'naver') {%>
					<img src="<%= user.profileImage %>" alt="프로필 이미지" class="rounded-circle mb-3"
					style="width: 120px; height: 120px; object-fit: cover;">
				<% }else{ %>
					<img src="/images/profile/<%= user.profileImage %>" alt="프로필 이미지" class="rounded-circle mb-3"
						style="width: 120px; height: 120px; object-fit: cover;">
				<% } %>
				<div class="small text-muted mb-2"><%=user.email %></div>

				<!-- 추가 필드: 이름 / 주소 -->
				<p class="mb-1">이름 : <strong><%=user.name %></strong></p>
				<p class="mb-0">주소 : <strong><%=user.address %></strong></p>

				<a class="btn btn-sm btn-brand mt-3" href="/user/modify">회원정보 수정</a>
				<a class="btn btn-sm btn-brand mt-3" href="/user/delete">회원탈퇴</a>
			</div>
		</div>

		<div class="card shadow-sm">
			<div class="card-body">
				<h5 class="mb-3">내가 쓴 글</h5>
				<ul class="list-group list-group-flush">
					<li class="list-group-item d-flex justify-content-between align-items-center">
						제목1 <span class="small text-muted">2025-08-24</span>
					</li>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						제목2 <span class="small text-muted">2025-08-24</span>
					</li>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						제목3 <span class="small text-muted">2025-08-24</span>
					</li>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						제목4 <span class="small text-muted">2025-08-24</span>
					</li>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						제목5 <span class="small text-muted">2025-08-24</span>
					</li>
				</ul>
			</div>
		</div>

		<!-- 페이징 -->
		<nav aria-label="댓글 페이지" class="mt-3">
			<ul class="pagination justify-content-center">
				<!-- 이전 -->
				<li class="page-item disabled">
					<a class="page-link" href="#">이전</a>
				</li>

				<!-- 페이지 번호들 (더미) -->
				<li class="page-item active"><a class="page-link" href="#">1</a></li>
				<li class="page-item"><a class="page-link" href="#">2</a></li>
				<li class="page-item"><a class="page-link" href="#">3</a></li>
				<li class="page-item"><a class="page-link" href="#">4</a></li>
				<li class="page-item"><a class="page-link" href="#">5</a></li>
				<li class="page-item"><a class="page-link" href="#">6</a></li>
				<li class="page-item"><a class="page-link" href="#">7</a></li>
				<li class="page-item"><a class="page-link" href="#">8</a></li>
				<li class="page-item"><a class="page-link" href="#">9</a></li>
				<li class="page-item"><a class="page-link" href="#">10</a></li>

				<!-- 다음 -->
				<li class="page-item">
					<a class="page-link" href="#">다음</a>
				</li>
			</ul>
		</nav>

	</main>

    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>