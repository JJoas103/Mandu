<!doctype html>
<html lang="ko">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>board_delete</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>

<body>
	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">
		<div class="row justify-content-center">
			<div class="col-md-7 col-lg-6">
				<div class="card shadow-sm">
					<div class="card-body p-4">
						<h4 class="mb-3">회원 탈퇴</h4>
						<p class="text-muted mb-4">비밀번호를 입력하세요. 탈퇴 후에는 되돌릴 수 없습니다.</p>

						<form action="/user/delete" method="post"
							onsubmit="return confirm('정말로 탈퇴하겠습니까? 이 작업은 되돌릴 수 없습니다.');">

							<div class="row g-3">
								<!-- 비밀번호 -->
								<div class="col-12">
									<label class="form-label">비밀번호 <span class="text-danger">*</span></label>
									<input type="password" class="form-control" name="password"
										placeholder="비밀번호를 입력하세요" id="deletePasswordInput" required />

									<!-- 서버 바인딩 에러 메시지 -->
									<div class="form-text text-danger">비밀번호가 일치하지 않습니다</div>

								</div>

								<div class="col-12 form-check">
									<input class="form-check-input" type="checkbox" id="showPwChk"
										onchange="togglePassword()">
									<label class="form-check-label" for="showPwChk">비밀번호 표시</label>
								</div>
							</div>

							<div class="d-grid mt-4 gap-2">
								<button type="submit" class="btn btn-brand">삭제하기</button>
								<a href="/user/info" class="btn btn-outline-secondary">취소</a>
							</div>
						</form>
					</div><!-- /card-body -->
				</div><!-- /card -->
			</div>
		</div>
	</main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>