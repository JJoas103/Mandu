<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>로그인</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<main class="container my-4">
		<div class="row justify-content-center">
			<div class="col-md-6 col-lg-5">
				<div class="card shadow-sm">
					<div class="card-body p-4">
						<h4 class="mb-3">로그인</h4>
						
						<form action="/user/login" method="post">

							<% if(errorMessage) { %>
								<div class="alert alert-danger"><%= errorMessage %></div>
							<% } %>

							<div class="mb-3">
								<label for="member_email" class="form-label">이메일</label> 
								<input type="email" class="form-control" name="email" id="member_email" placeholder="이메일을 입력하세요">
							</div>
							<div class="mb-3">
								<label for="member_pass" class="form-label">비밀번호</label> 
								<input type="password" class="form-control" name="password" id="member_pass" placeholder="비밀번호를 입력하세요" >
							</div>
							<div class="d-grid gap-2">
								<input class="btn btn-brand" type="submit" value="로그인">
							</div>
						</form>

						<hr class="my-3">
						<div class="d-grid gap-2">
							<a href="/auth/google" class="btn btn-outline-danger">Google로 로그인</a>
							<a href="/auth/kakao" class="btn btn-warning">카카오로 로그인</a>
							<a href="/auth/naver" class="btn btn-success">네이버로 로그인</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>