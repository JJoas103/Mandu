<!-- views/error.ejs -->
<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= statusCode %> 오류
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/header') %>

        <main class="container my-5 d-flex justify-content-center">
            <div class="card text-center p-5" style="max-width: 480px; width: 100%;">

                <div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle" style="width:80px; height:80px;
                       background: linear-gradient(180deg, var(--brand) 0%, #ffe9a8 100%);
                       border: 3px solid var(--brown);">
                    <span style="font-size: 2rem;">⚠️</span>
                </div>

                <h1 class="fw-bold mb-2" style="font-size: 3rem; color: var(--brown);">
                    <%= statusCode %>
                </h1>
                <p class="mb-4" style="color: #6b4b00;">
                    불편을 드려 죄송합니다!!
                </p>

                <a href="/" class="btn btn-brown">메인으로 돌아가기</a>
            </div>
        </main>

        <%- include('../partials/footer') %>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>