<!-- 푸터 -->
<footer class="py-5 mt-5">
  <div class="container text-center footer">
    <div class="small">© 2026 모여봄 - 서울 여유 공간 탐색 플랫폼</div>
    <div class="small mt-1">팀 프로젝트 1조</div>
  </div>
</footer>
<script>
  // 비로그인 상태에서 로그인 필요한 링크 클릭 시, 화면 이동 전에 confirm으로 안내
  function requireLogin(event) {
    event.preventDefault();
    if (confirm('로그인이 필요합니다.')) {
      location.href = '/member/login';
    }
    return false;
  }
</script>
<% if (typeof user !== 'undefined' && user) { %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const userId = "<%= user._id %>";
    const userDistrict = "<%= user.address ? user.address : '' %>";
    const meetingAlertEnabled = <%= user.alert_meeting ? 'true' : 'false' %>;
    if (userId) {
      socket.emit("joinUser", userId);
    }
    if (userDistrict && meetingAlertEnabled) {
      socket.emit("joinDistrict", userDistrict);
    }
    socket.on("newMeetingAlert", (data) => {
      alert(
        "[새 모임 알림]\n" +
        data.message + "\n\n" +
        "모임명: " + data.title + "\n" +
        "동네: " + data.district + "\n" +
        "일시: " + data.meetingDate
      );
    });
    socket.on("newFeedAlert", (data) => {
      alert(
        "[새 실시간 제보 알림]\n" +
        data.message + "\n\n" +
        "장소: " + data.district + "\n" +
        "내용: " + data.content
      );
    });
  </script>
<% } %>