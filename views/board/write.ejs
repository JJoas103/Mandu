<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>글쓰기</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>

<body>

    <!-- 헤더 -->
    <%- include('../partials/header') %>

    <!-- 메인 -->
    <main class="container my-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-3">게시글 작성</h4>
                <form action="/board/write" method="post" enctype="multipart/form-data"> 
                    <div>
                        <select name="category" id="">
                            <option value="">카테고리를 선택하세요</option>
                            <option value="free">자유게시판</option>
                            <option value="study">학업게시판</option>
                            <option value="suggestion">건의게시판</option>
                            <option value="counsel">상담게시판</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="board_title" class="form-label">제목</label>
                        <input type="text" id="board_title" class="form-control" placeholder="제목을 입력하세요" name="title" />
                    </div>
                    <div class="mb-3">
                        <label for="board_content" class="form-label">본문</label>
                        <textarea name="content" class="form-control" rows="8" placeholder="내용을 입력하세요"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="uploadFile" class="form-label">첨부 이미지</label>
                        <input type="file" class="form-control" name="uploadFile" />
                    </div> 

                    <div class="d-flex gap-2">
                        <input type="submit" value="글쓰기" class="btn btn-brand" />
                        <a class="btn btn-outline-secondary" href="board_list.html">취소</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>