<!doctype html>
<html lang="ko">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>게시판 리스트</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>

<body>
	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">
		<!-- 일러스트 -->
		<section class="hero p-5 mb-4">
			<div class="row align-items-center">
				<div class="col-lg-7">
					<h1 class="display-5 mb-3">자유게시판</h1>
					<p class="lead">자유게시판입니다</p>
				</div>
				<div class="col-lg-5 d-none d-lg-block">
					<img src="/images/free.png" alt="자유게시판 일러스트" class="img-fluid rounded shadow-sm">
				</div>
			</div>
		</section>

		<!-- 카테고리 버튼 + 글쓰기 버튼 -->
		<div class="d-flex justify-content-between align-items-center mb-4 mt-1">
			<div class="d-flex flex-wrap gap-2">
				<a href="/board/list/free" class="btn btn-brand btn-lg active-board">자유게시판</a>
				<a href="/board/list/study" class="btn btn-brand btn-lg">학업게시판</a>
				<a href="/board/list/suggestion" class="btn btn-brand btn-lg">건의게시판</a>
				<a href="/board/list/counsel" class="btn btn-brand btn-lg">상담게시판</a>
			</div>
			<a class="btn btn-lg btn-brown" href="/board/write">글쓰기</a>
		</div>

		<hr class="my-4">

		<!-- 게시글 10개(최신순) -->
		<div class="row g-3">
            <% boards.forEach(board => { %>
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">

						<% if(board.file){ %>
							<img class="card-img-top" alt="게시판이미지" src="/images/upload/<%=board.file%>"> 
						<% } else { %>
							<div class="placeholder-img">이미지 없음</div>
						<% } %>
                        
                        <div class="card-body">
                            <h6 class="card-title"><%= board.title %></h6>
                            <div class="small text-muted">작성자: <%= board.author.name %> · <%= board.createdAt.toLocaleDateString() %></div>
                            <p class="card-text mt-2 small"><%= board.content %></p>
                            <a class="stretched-link" href="/board/info/<%= board.id %>"></a>
                        </div>
                    </div>
                </div>
            <% })%>

		</div>

		<!-- 페이징  -->
		<nav aria-label="page" class="mt-4">
			<ul class="pagination justify-content-center">

				<!-- 이전 버튼 -->
				<li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
				<!-- 사용자가 1페이지면 이전 버튼 비활성화 -->
					<a class="page-link" href="/board/list/<%=category %>?page=<%= currentPage - 1%>">이전</a>
				</li>
				<!-- 사용자의 현재 페이지에서 -1한 페이지를 요청 -->

				<!-- 페이지 번호들 -->
				<% for(let i=1; i<= totalPages; i++) {%>
					<li class="page-item <%= currentPage === i ? 'active' : '' %>"> 
						<a class="page-link" href="/board/list/<%=category%>?page=<%=i%>">
							<%=i %>
						</a>
					</li>
				<% } %>

				<li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
				<!-- 전체 페이지와 현재 페이지가 일치하면 다음버튼 비활성화 -->
					<a class="page-link" href="/board/list/<%=category %>?page=<%= currentPage + 1%>">다음</a>
				</li>

			</ul>
		</nav>
	</main>

	<!-- 푸터 -->
    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>