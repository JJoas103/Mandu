<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>모여봄 - 서울 모임 플랫폼</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">

		<!-- 일러스트 -->
		<section class="hero p-5 mb-4">
			<div class="row align-items-center">
				<div class="col-lg-7">
					<h1 class="display-5 mb-3">지금, 여유로운 서울을 만나다</h1>
					<p class="lead">실시간 혼잡도와 모임 정보로 편안한 동네를 찾아보세요</p>
				</div>
				<div class="col-lg-5 d-none d-lg-block text-center">
					<div style="font-size:100px;">🗺️</div>
				</div>
			</div>
		</section>

		<!-- 검색바 -->
		<div class="mb-4">
			<form action="#" method="get" class="d-flex gap-2">
				<input type="text" name="keyword" class="form-control form-control-lg" placeholder="🔍 지역·장소·모임 검색">
				<button type="submit" class="btn btn-brand btn-lg">검색</button>
			</form>
		</div>

		<!-- 지도 + 핫플 -->
		<div class="row g-3 mb-4">
			<div class="col-lg-9">
				<div class="map-wrap">
					<svg class="map-svg" viewBox="0 0 900 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
						<rect width="900" height="600" fill="#dce8d4"/>
						<path d="M0,300 Q220,240 450,300 Q680,360 900,300 L900,600 L0,600Z" fill="#c8dbbf" opacity="0.5"/>
						<rect x="80"  y="120" width="80"  height="58" rx="4" fill="#b8ccb0"/>
						<rect x="200" y="90"  width="120" height="75" rx="4" fill="#b8ccb0"/>
						<rect x="360" y="130" width="85"  height="60" rx="4" fill="#b8ccb0"/>
						<rect x="500" y="105" width="110" height="70" rx="4" fill="#b8ccb0"/>
						<rect x="660" y="115" width="95"  height="65" rx="4" fill="#b8ccb0"/>
						<rect x="790" y="110" width="85"  height="60" rx="4" fill="#b8ccb0"/>
						<path d="M160,145 L860,145" stroke="#fff" stroke-width="8" stroke-linecap="round"/>
						<path d="M120,250 L800,250" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
						<path d="M380,80 L380,520"  stroke="#fff" stroke-width="8" stroke-linecap="round"/>
						<path d="M600,70 L600,500"  stroke="#fff" stroke-width="5" stroke-linecap="round"/>
					</svg>

					<!-- 지도 마커 (각 마커 클릭 시 장소 상세로 이동) -->
					<a class="map-marker" style="top:40%; left:29%;" href="place_info.html?place_id=1">
						<span class="marker-bubble green">연남동 · 여유</span>
					</a>
					<a class="map-marker" style="top:33%; left:44%;" href="place_info.html?place_id=2">
						<span class="marker-bubble yellow">북촌 · 보통</span>
					</a>
					<a class="map-marker" style="top:50%; left:62%;" href="place_info.html?place_id=3">
						<span class="marker-bubble red">강남역 · 혼잡</span>
					</a>
					<a class="map-marker" style="top:54%; left:46%;" href="place_info.html?place_id=4">
						<span class="marker-bubble green">서래마을 · 여유</span>
					</a>
					<a class="map-marker" style="top:63%; left:60%;" href="place_info.html?place_id=5">
						<span class="marker-bubble yellow">잠실 · 보통</span>
					</a>
					<a class="map-marker" style="top:27%; left:76%;" href="place_info.html?place_id=6">
						<span class="marker-bubble green">서울숲 · 여유</span>
					</a>

					<!-- 범례 -->
					<div class="map-legend">
						<span><span class="dot dot-green"></span> 여유</span>
						<span><span class="dot dot-yellow"></span> 보통</span>
						<span><span class="dot dot-red"></span> 혼잡</span>
					</div>
				</div>
			</div>

			<!-- 실시간 급증 TOP 패널 -->
			<div class="col-lg-3">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<h6 class="card-title mb-3">🔥 실시간 급증 TOP</h6>
						<ul class="list-group list-group-flush">
							<li class="list-group-item d-flex justify-content-between">
								<span>명동</span>
								<span class="text-danger fw-bold">+42%</span>
							</li>
							<li class="list-group-item d-flex justify-content-between">
								<span>홍대입구</span>
								<span class="text-danger fw-bold">+28%</span>
							</li>
							<li class="list-group-item d-flex justify-content-between">
								<span>강남역</span>
								<span class="text-danger fw-bold">+19%</span>
							</li>
							<li class="list-group-item d-flex justify-content-between">
								<span>잠실</span>
								<span class="text-danger fw-bold">+12%</span>
							</li>
							<li class="list-group-item d-flex justify-content-between">
								<span>서래마을</span>
								<span class="text-success fw-bold">-8%</span>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<hr class="my-4">

		<!-- 지금 한산한 명소 -->
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h5 class="mb-0">🌿 지금 한산한 명소</h5>
			<a href="#" class="small text-decoration-none" style="color:var(--brand);">전체보기</a>
		</div>
		<div class="row g-3 mb-4">
			<div class="col-md-3 col-6">
				<a href="place_info.html?place_id=1" class="text-decoration-none text-dark">
					<div class="card h-100 shadow-sm">
						<div class="placeholder-img">🌳</div>
						<div class="card-body">
							<h6 class="card-title mb-1">연남동</h6>
							<span class="chip chip-green"><span class="dot dot-green"></span> 여유</span>
						</div>
					</div>
				</a>
			</div>
			<div class="col-md-3 col-6">
				<a href="place_info.html?place_id=4" class="text-decoration-none text-dark">
					<div class="card h-100 shadow-sm">
						<div class="placeholder-img">🏘️</div>
						<div class="card-body">
							<h6 class="card-title mb-1">서래마을</h6>
							<span class="chip chip-green"><span class="dot dot-green"></span> 여유</span>
						</div>
					</div>
				</a>
			</div>
			<div class="col-md-3 col-6">
				<a href="place_info.html?place_id=7" class="text-decoration-none text-dark">
					<div class="card h-100 shadow-sm">
						<div class="placeholder-img">🌸</div>
						<div class="card-body">
							<h6 class="card-title mb-1">성수동</h6>
							<span class="chip chip-yellow"><span class="dot dot-yellow"></span> 보통</span>
						</div>
					</div>
				</a>
			</div>
			<div class="col-md-3 col-6">
				<a href="place_info.html?place_id=8" class="text-decoration-none text-dark">
					<div class="card h-100 shadow-sm">
						<div class="placeholder-img">🎋</div>
						<div class="card-body">
							<h6 class="card-title mb-1">익선동</h6>
							<span class="chip chip-yellow"><span class="dot dot-yellow"></span> 보통</span>
						</div>
					</div>
				</a>
			</div>
		</div>

		<hr class="my-4">

		<!-- 근처 모임 -->
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h5 class="mb-0">📌 근처 모임</h5>
			<a href="meeting_list.html" class="small text-decoration-none" style="color:var(--brand);">전체보기</a>
		</div>
		<div class="row g-3">
			<div class="col-md-6">
				<a href="meeting_info.html?meeting_id=1" class="text-decoration-none text-dark">
					<div class="card h-100 shadow-sm">
						<div class="card-body">
							<div class="d-flex justify-content-between mb-2">
								<h6 class="card-title mb-0">연남동 산책 + 카페 탐방</h6>
								<span class="small text-muted">2/5명</span>
							</div>
							<div class="small text-muted mb-2">
								📍 연남동 · 오늘 15:00
								<span class="chip chip-green ms-1"><span class="dot dot-green"></span> 여유</span>
							</div>
							<div>
								<span class="tag-soft">조용한카페</span>
								<span class="tag-soft">주차가능</span>
								<span class="tag-soft">2시간</span>
							</div>
						</div>
					</div>
				</a>
			</div>
			<div class="col-md-6">
				<a href="meeting_info.html?meeting_id=2" class="text-decoration-none text-dark">
					<div class="card h-100 shadow-sm">
						<div class="card-body">
							<div class="d-flex justify-content-between mb-2">
								<h6 class="card-title mb-0">서래마을 브런치 모임</h6>
								<span class="small text-muted">3/4명</span>
							</div>
							<div class="small text-muted mb-2">
								📍 서래마을 · 오늘 11:00
								<span class="chip chip-green ms-1"><span class="dot dot-green"></span> 여유</span>
							</div>
							<div>
								<span class="tag-soft">대중교통</span>
								<span class="tag-soft">실내위주</span>
							</div>
						</div>
					</div>
				</a>
			</div>
		</div>

	</main>

	<!-- 푸터 -->
    <%- include('partials/footer') %>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
