<%- include('partials/header') %>

<main class="container my-4">
  <!-- 일러스트 -->
  <section class="hero p-5 mb-4">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <h1 class="display-5 mb-3">지금, 여유로운 서울을 만나다</h1>
        <p class="lead">실시간 혼잡도와 모임 정보로 편안한 동네를 찾아보세요</p>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <div style="font-size: 100px">🗺️</div>
      </div>
    </div>
  </section>

  <!-- 검색바 (더미) -->
  <div class="mb-4">
    <form action="#" method="get" class="d-flex gap-2">
      <input type="text" name="keyword" class="form-control form-control-lg" placeholder="🔍 지역·장소·모임 검색" />
      <button type="submit" class="btn btn-brand btn-lg">검색</button>
    </form>
  </div>

  <!-- 지도 시각화 (더미) -->
  <div class="row g-3 mb-4">
    <div class="col-lg-9">
      <div class="map-wrap">
        <svg class="map-svg" viewBox="0 0 900 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
          <rect width="900" height="600" fill="#dce8d4" />
          <path d="M0,300 Q220,240 450,300 Q680,360 900,300 L900,600 L0,600Z" fill="#c8dbbf" opacity="0.5" />
          <!-- 지도 배경 일러스트 유지 -->
        </svg>

        <!-- 지도 마커 -->
        <a class="map-marker" style="top: 40%; left: 29%" href="/place/info/1">
          <span class="marker-bubble green">연남동 · 여유</span>
        </a>
        <a class="map-marker" style="top: 33%; left: 44%" href="/place/info/2">
          <span class="marker-bubble yellow">북촌 · 보통</span>
        </a>
        <a class="map-marker" style="top: 50%; left: 62%" href="/place/info/3">
          <span class="marker-bubble red">강남역 · 혼잡</span>
        </a>
      </div>
    </div>

    <!-- 실시간 급증 TOP 패널 -->
    <div class="col-lg-3">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title mb-3">🔥 실시간 급증 TOP</h6>
          <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between"><span>명동</span><span class="text-danger fw-bold">+42%</span></li>
            <li class="list-group-item d-flex justify-content-between"><span>홍대입구</span><span class="text-danger fw-bold">+28%</span></li>
            <li class="list-group-item d-flex justify-content-between"><span>강남역</span><span class="text-danger fw-bold">+19%</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <hr class="my-4" />

  <!-- 최근 모임 -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">📌 최신 모임</h5>
    <a href="/meeting/list" class="small text-decoration-none" style="color: var(--brand)">전체보기</a>
  </div>
  <div class="row g-3">
    <% mainMeetings.forEach(meeting => { %>
    <div class="col-md-4">
      <a href="/meeting/info/<%= meeting._id %>" class="text-decoration-none text-dark">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h6 class="card-title mb-2"><%= meeting.title %></h6>
            <div class="small text-muted mb-2">
              📍 <%= meeting.area %> · <%= meeting.status === 'recruit' ? '모집중' : '마감' %>
            </div>
            <div class="small text-muted">작성자: <%= meeting.author.nickname %></div>
          </div>
        </div>
      </a>
    </div>
    <% }) %>
  </div>
</main>

<%- include('partials/footer') %>
