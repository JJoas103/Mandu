<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>장소 상세 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
	<%- include('partials/header') %>

		<main class="container my-4">
			<!-- 일러스트 -->
			<section class="hero p-5 mb-4">
				<div class="row align-items-center">
					<div class="col-lg-7">
						<h1 class="display-5 mb-3">지금, 여유로운 서울을 만나다</h1>
						<p class="lead">실시간 혼잡도와 모임 정보로 편안한 동네를 찾아보세요</p>
					</div>
					<div class="col-lg-5 d-none d-lg-block text-center">
						<div style="font-size: 100px">🗺️</div>
					</div>
				</div>
			</section>

			<!-- 검색바 (더미) -->
			<div class="mb-4">
				<form action="/place/info/" method="get" class="d-flex gap-2">
					<input type="text" name="keyword" class="form-control form-control-lg"
						placeholder="🔍 지역·장소·모임 검색" />
					<button type="submit" class="btn btn-brand btn-lg">검색</button>
				</form>
			</div>

			<!-- 지도 시각화 (더미) -->
			<div class="row g-3 mb-4">
				<!-- 지도 + 핫플 -->
				<div class="row g-3 mb-4">
					<div class="col-lg-9">
						<div class="map-wrap" id="map">
							<!-- 범례 -->
							<div class="map-legend">
								<span><span class="dot dot-green"></span> 여유</span>
								<span><span class="dot dot-yellow"></span> 보통</span>
								<span><span class="dot dot-red"></span> 혼잡</span>
							</div>
						</div>
						<script type="text/javascript"
							src="//dapi.kakao.com/v2/maps/sdk.js?appkey=<%= process.env.KAKAO_MAP_API %>"></script>
						<div id="markerInfo" data-markers='<%- JSON.stringify(markerInfo) %>'></div>
						<script src="/js/main.js"></script>
					</div>

					<!-- 실시간 급증 TOP 패널 -->
					<div class="col-lg-3">
						<div class="card shadow-sm h-100">
							<div class="card-body">
								<h6 class="card-title mb-3">🔥 실시간 급증 TOP</h6>
								<ul class="list-group list-group-flush">
									<% surgePlace.forEach(surge => { %>
									<li class="list-group-item d-flex justify-content-between">
										<span><%= surge.area_nm %></span>
										<span class="text-danger fw-bold"><%= surge.surge_pct %>%</span>
									</li>
									<% }) %>
								</ul>
								<br>
								<h6 class="card-title mb-3">🔥 혼잡붐빔 TOP 5</h6>
								<ul class="list-group list-group-flush">
									<% congestPlaceTopFive.forEach(surge => { %>
									<li class="list-group-item d-flex justify-content-between">
										<span><%= surge.area_nm %></span>
										<span class="text-danger fw-bold"><%= surge.area_congest_lvl %></span>
									</li>
									<% }) %>
								</ul>
							</div>
						</div>
					</div>
				</div>

				<hr class="my-4">

				<!-- 지금 한산한 명소 -->
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h5 class="mb-0">🌿 지금 한산한 명소</h5>
					<a href="#" class="small text-decoration-none" style="color:var(--brand);">전체보기</a>
				</div>

				<div class="row g-3 mb-4">
					<% placeInfoLimt.forEach(place=> { %>
						<div class="col-md-3 col-6">
							<a href="#" class="text-decoration-none text-dark">
								<div class="card h-100 shadow-sm">
									<div class="placeholder-img">🌳</div>
									<div class="card-body">
										<h6 class="card-title mb-1">
											<%= place.name %>
										</h6>
										<span class="chip chip-green"><span class="dot dot-green"></span>
											<%= place.congest_lvl %>
										</span>
									</div>
								</div>
							</a>
						</div>
						<% }) %>
				</div>

				<hr class="my-4">

				<!-- 최근 모임 -->
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h5 class="mb-0">📌 최신 모임</h5>
					<a href="/meeting/list" class="small text-decoration-none" style="color: var(--brand)">전체보기</a>
				</div>
				<div class="row g-3">
					<% mainMeetings.forEach(meeting=> { %>
						<div class="col-md-4">
							<a href="/meeting/info/<%= meeting._id %>" class="text-decoration-none text-dark">
								<div class="card h-100 shadow-sm">
									<div class="card-body">
										<h6 class="card-title mb-2">
											<%= meeting.title %>
										</h6>
										<div class="small text-muted mb-2">
											📍 <%= meeting.area %> · <%= meeting.status==='recruit' ? '모집중' : '마감' %>
										</div>
										<div class="small text-muted">작성자: <%= meeting.author.nickname %>
										</div>
									</div>
								</div>
							</a>
						</div>
						<% }) %>
				</div>
		</main>

		<!-- 푸터 -->
		<%- include('partials/footer') %>
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
