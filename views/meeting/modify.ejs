	<!-- 헤더 -->
    <%- include('../partials/header') %>
	
	<!-- 메인 -->
	<main class="container my-4">
		<div class="card shadow-sm">
			<div class="card-body p-4">
				<h4 class="mb-3">게시글 수정</h4>
				<form action="/feed/modify" method="post" enctype="multipart/form-data">
					<div class="mb-3">
						<label for="board_title" class="form-label">제목</label> 
						<input name="title" type="text" id="board_title" class="form-control" placeholder="제목을 입력하세요" value="<%= board.title%>" />
					</div>
					<div class="mb-3">
						<label for="board_content" class="form-label">본문</label>
						<textarea name="content" class="form-control" rows="8" placeholder="내용을 입력하세요"><%= board.content %></textarea>
					</div>
					<div class="mb-3">
						<label for="uploadFile" class="form-label">첨부 이미지</label> 
						<input type="file" class="form-control" name="uploadFile" />
					</div> 
					<div class="d-flex gap-2">
						<input type="submit" value="수정" class="btn btn-brand" />
						<a class="btn btn-outline-secondary" href="/feed/info/<%= board.id %>">취소</a>
					</div>
				</form>
			</div>
		</div>
	</main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
