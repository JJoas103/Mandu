<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>장소 상세 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>
	<!-- 메인 -->
	<main class="container my-4">
		<article class="card shadow-sm">
			<div class="card-body p-4">
				<h4 class="mb-2">게시글 삭제</h4>
				<div class="text-muted small mb-3">
					게시글을 삭제하려면 비밀번호를 입력하세요.
				</div>

				<!-- 안내 카드 -->
				<div class="alert alert-warning small" role="alert">
					삭제 시 되돌릴 수 없습니다. 정말 삭제하시겠습니까?
				</div>

				<!-- 삭제 폼 -->
				<form action="/feed/delete/<%= boardId %>" method="post" class="mt-3">
					<div class="mb-3">
						<label for="password" class="form-label">비밀번호</label>
						<div class="input-group">
							<input type="password" class="form-control" id="password" name="password" placeholder="비밀번호를 입력하세요" required>
							<!-- <button class="btn btn-outline-secondary" type="button" id="togglePw">표시</button> -->
						</div>
						<!-- 서버에서 실패 시 에러 메시지 바인딩 -->
						<div class="form-text text-danger">비밀번호가 일치하지 않습니다</div>
					</div>

					<div class="mt-4 d-flex gap-2">
						<a class="btn btn-outline-secondary" href="board_list.html">취소</a>
						<button type="submit" class="btn btn-brand">삭제</button>
					</div>
				</form>
			</div>
		</article>
	</main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
