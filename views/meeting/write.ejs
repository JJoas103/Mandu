<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>장소 상세 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>
    <!-- 메인 -->
	<main class="container my-4">
		<div class="row justify-content-center">
			<div class="col-lg-8">
				<div class="card shadow-sm">
					<div class="card-body p-4">
						<h4 class="mb-1">모임 만들기</h4>
						<p class="text-muted small mb-4">장소를 선택하면 주차장·화장실 정보가 자동으로 첨부됩니다</p>

						<form action="/meeting/write" method="post" enctype="multipart/form-data">

							<!-- 제목 -->
							<div class="mb-3">
								<label for="meeting_title" class="form-label">모임 제목 <span class="text-danger">*</span></label>
								<input type="text" id="meeting_title" name="title" class="form-control" placeholder="어떤 모임인지 간단히 적어주세요" required />
							</div>

							<div class="mb-3">
									<label class="form-label">장소 선택 <span class="text-danger">*</span></label>
									<div id="map" style="width:100%; height:300px; margin-bottom:10px;"></div> <!-- 지도 컨테이너 -->
									<input type="text" id="place_name" name="area" class="form-control" readonly required>
									<div id="markerInfo" data-markers='<%- JSON.stringify(markerInfo) %>'></div>
							</div>

									<% if (typeof placeInfo !== 'undefined' && placeInfo) { %>
								<!-- 장소 정보 자동 첨부 (선택 시 동적 표시) -->
								<div class="mt-2 p-3 rounded" style="background:var(--brand-50); border:1px solid var(--brand-border);">
									<div class="small fw-bold mb-2">선택된 장소의 현재 정보</div>
									<div class="d-flex gap-2 flex-wrap">
										<!-- 혼잡도 정보 -->
										 <% if (placeInfo.congest_lvl === '여유') { %>
										<span class="chip chip-green"><span class="dot dot-green"></span> 현재 여유</span>
										 <% } else if (placeInfo.congest_lvl === '보통' || placeInfo.congest_lvl === '약간 붐빔') { %>
										<span class="chip chip-yellow"><span class="dot dot-yellow"></span> <%= placeInfo.congest_lvl %></span>
										 <% } else if (placeInfo.congest_lvl === '혼잡') { %>
										<span class="chip chip-red"><span class="dot dot-red"></span> 혼잡</span>
										 <% } %>
											<% if (typeof parkingCount !== 'undefined' && parkingCount > 0) { %>
										<span class="chip chip-brand">🅿️ 주변 주차장 <%= parkingCount %>곳</span>
										<% } %>
										<% if (typeof restroomCount !== 'undefined' && restroomCount > 0) { %>
										<span class="chip chip-blue">🚻 주변 화장실 <%= restroomCount %>곳</span>
										<% } %>
									</div>
								</div>
								<% } %>

							<!-- 소개글 -->
							<div class="mb-3">
								<label for="meeting_desc" class="form-label">소개글 <span class="text-danger">*</span></label>
								<textarea id="meeting_desc" name="content" class="form-control" rows="5" placeholder="모임을 소개해주세요. 어떤 활동을 하나요? 준비물은 무엇인가요?" required></textarea>
							</div>

							<!-- 일시 + 인원 -->
							<div class="row g-3 mb-3">
								<div class="col-md-6">
									<%
										// 오늘 날짜를 미리 넣어둠
										const today = new Date().toISOString().split('T')[0];
									%>
									<label for="meeting_date" class="form-label">모임 날짜 <span class="text-danger">*</span></label>
									<input type="date" id="meeting_date" name="meeting_date" class="form-control" 
													min="<%= today %>" value="<%= today %>" required>
								</div>
								<div class="col-md-3">
									<label for="meeting_time" class="form-label">시간 <span class="text-danger">*</span></label>
									<input type="time" id="meeting_time" name="meeting_time" class="form-control" required>
								</div>
								<div class="col-md-3">
									<label for="max_headcount" class="form-label">모집 인원 <span class="text-danger">*</span></label>
									<input type="number" id="max_headcount" name="maxParticipants" class="form-control" value="4" min="2" max="20" required>
								</div>
							</div>

							<!-- 태그 (체크박스) -->
							<div class="mb-3">
								<label class="form-label">태그 (복수 선택)</label>
								<div class="d-flex flex-wrap gap-2">
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="주차가능" id="tag1" checked>
										<label class="form-check-label" for="tag1">주차 가능</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="조용한카페" id="tag2" checked>
										<label class="form-check-label" for="tag2">조용한 카페</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="반려동물" id="tag3">
										<label class="form-check-label" for="tag3">반려동물 동반</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="야외활동" id="tag4">
										<label class="form-check-label" for="tag4">야외 활동</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="실내위주" id="tag5">
										<label class="form-check-label" for="tag5">실내 위주</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="대중교통" id="tag6">
										<label class="form-check-label" for="tag6">대중교통 추천</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="2시간이내" id="tag7">
										<label class="form-check-label" for="tag7">2시간 이내</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="tags" value="식사포함" id="tag8">
										<label class="form-check-label" for="tag8">식사 포함</label>
									</div>
								</div>
							</div>

							<!-- 이미지 -->
							<div class="mb-3">
								<label for="upload_file" class="form-label">첨부 이미지 (필수)</label>
								<input type="file" id="upload_file" name="imageUrl" class="form-control" accept="image/*" required>
							</div>

							<!-- 제출 -->
							<div class="d-flex gap-2 mt-4">
								<button type="submit" class="btn btn-brand btn-lg">모임 게시하기</button>
								<a class="btn btn-outline-secondary btn-lg" href="/meeting/list">취소</a>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		<script type="text/javascript" src="//dapi.kakao.com/v2/maps/sdk.js?appkey=<%= process.env.KAKAO_MAP_API %>"></script>
		<script>
			const markerDataDiv = document.getElementById('markerInfo');
			const markerData = JSON.parse(markerDataDiv.dataset.markers);
			const mapContainer = document.getElementById('map');
			const mapOption = {
					center: new kakao.maps.LatLng(37.5665, 126.9780), // 서울 중심
					level: 8
			};
			const map = new kakao.maps.Map(mapContainer, mapOption);
			const imageSize = new kakao.maps.Size(35, 35);
			const markers = markerData.map(p => {
					let mkImg = "/images/marker_available.png";
					if (p.congest_lvl === '혼잡') mkImg = "/images/marker_crowdede.png";
					else if (p.congest_lvl === '약간 붐빔') mkImg = "/images/marker_little_crowded.png";
					else if (p.congest_lvl === '보통') mkImg = "/images/marker_normal.png";
					const markerImage = new kakao.maps.MarkerImage(mkImg, imageSize);
					const marker = new kakao.maps.Marker({
							map: map,
							position: new kakao.maps.LatLng(p.latitude, p.longitude),
							title: p.name,
							image: markerImage
					});
					kakao.maps.event.addListener(marker, 'click', function() {
							document.getElementById('place_name').value = p.name;
							// 선택 시 강조 효과나 알림을 줄 수 있음
							alert(p.name + ' 장소가 선택되었습니다.');
					});
					return marker;
			});
			document.getElementById('meeting_date').addEventListener('blur', function(e) {
				const val = e.target.value; // 형식: "YYYY-MM-DD"
				if (val) {
					const year = parseInt(val.split('-')[0], 10);
					// 허용할 최대 연도
					const MAX_ALLOWED_YEAR = 2030; 
					if (year > MAX_ALLOWED_YEAR) {
						// 오늘로 리셋
						alert(MAX_ALLOWED_YEAR + '년 이전만 선택 가능합니다')
						e.target.value = new Date().toISOString().split('T')[0];
					}
				}
			});
		</script>
  </body>
</html>
