<!doctype html>
<html lang="ko">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>장소 상세 - 모여봄</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>

<body>

  <!-- 헤더 -->
  <%- include('../partials/header') %>

    <main class="container my-4">
      <!-- 히어로 -->
      <section class="hero p-5 mb-4">
        <div class="row align-items-center">
          <div class="col-lg-7">
            <h1 class="display-5 mb-3">모임 게시판</h1>
            <p class="lead">여유로운 시간대, 한산한 동네에서 함께할 사람을 찾아보세요</p>
          </div>
          <div class="col-lg-5 d-none d-lg-block text-center">
            <div style="font-size: 100px">🤝</div>
          </div>
        </div>
      </section>

      <!-- 필터 + 글쓰기 -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex flex-wrap gap-2">
          <a href="/meeting/list" class="btn <%= !currentStatus ? 'btn-brand active-board' : 'btn-outline-brand' %>">전체</a>
          <a href="/meeting/list?status=recruit" class="btn <%= currentStatus === 'recruit' ? 'btn-brand active-board' : 'btn-outline-brand' %>">모집중</a>
        </div>
        <a class="btn btn-lg btn-brand" href="/meeting/write">+ 모임 만들기</a>
      </div>

      <hr class="my-4" />

      <!-- 모임 카드 목록 -->
      <div class="row g-3">
        <% if(meetings.length===0) { %>
          <div class="col-12 text-center py-5">
            <p class="text-muted">현재 등록된 모임이 없습니다.</p>
          </div>
          <% } %>
            <% meetings.forEach(meeting=> { %>
              <div class="col-md-6">
                <a href="/meeting/info/<%= meeting._id %>" class="text-decoration-none text-dark">
                  <div class="card h-100 shadow-sm <%= meeting.isExpired ? 'expired-card' : '' %>">
                    <div class="card-body">
                      <div class="d-flex justify-content-between mb-2">
                        <h6 class="card-title mb-0">
                          <%= meeting.title %>
                          <% if(meeting.isExpired) { %>
                            <span class="badge bg-secondary ms-1">기간만료</span>
                          <% } %>
                        </h6>
                        <% 
                          let chipClass = 'chip-green';
                          let dotClass = 'dot-green';
                          if (meeting.congestionLevel === '혼잡' || meeting.congestionLevel === '붐빔' || meeting.congestionLevel === '약간 붐빔') { 
                            chipClass = 'chip-red'; 
                            dotClass = 'dot-red'; 
                          } else if (meeting.congestionLevel === '보통') { 
                            chipClass = 'chip-yellow'; 
                            dotClass = 'dot-yellow'; 
                          }
                        %>
                        <span class="chip <%= chipClass %>"><span class="dot <%= dotClass %>"></span>
                          <%= meeting.congestionLevel %>
                        </span>
                      </div>
                      <div class="small text-muted mb-2">
                        <!-- 작성자 및 매너온도 추가 -->
                        <span><%= meeting.author.avatar_emoji %> <%= meeting.author.nickname %></span>
                        <span class="badge bg-light text-dark ms-1" style="border: 1px solid #ddd;">
                          <%= meeting.author.manner_score.toFixed(1) %>°C
                        </span>
                      </div>
                      <div class="small text-muted mb-2">
                        📍 <%= meeting.area %> · <%= meeting.meetingDate ? new
                            Date(meeting.meetingDate).toLocaleDateString() : '' %> ·
                            <%= meeting.participants.length %>/<%= meeting.maxParticipants %>명
                      </div>
                      <p class="small mb-2 text-truncate">
                        <%= meeting.content %>
                      </p>
                      <div>
                        <% meeting.tags.forEach(tag=> { %>
                          <span class="tag-soft">
                            <%= tag %>
                          </span>
                          <% }) %>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
              <% }) %>
      </div>

      <!-- 페이징 -->
      <% if(totalPages> 1) { %>
        <nav class="mt-4">
          <ul class="pagination justify-content-center">
            <% for(let i=1; i<=totalPages; i++) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="/meeting/list?page=<%= i %>">
                  <%= i %>
                </a>
              </li>
              <% } %>
          </ul>
        </nav>
        <% } %>
    </main>

    <!-- 푸터 -->
		<%- include('../partials/footer') %>
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
