<%- include('../partials/header') %>

<main class="container my-4">
  <!-- 히어로 -->
  <section class="hero p-5 mb-4">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <h1 class="display-5 mb-3">모임 게시판</h1>
        <p class="lead">여유로운 시간대, 한산한 동네에서 함께할 사람을 찾아보세요</p>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <div style="font-size: 100px">🤝</div>
      </div>
    </div>
  </section>

  <!-- 필터 + 글쓰기 -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex flex-wrap gap-2">
      <a href="/meeting/list" class="btn btn-brand active-board">전체</a>
      <a href="/meeting/list?status=recruit" class="btn btn-outline-brand">모집중</a>
    </div>
    <a class="btn btn-lg btn-brand" href="/meeting/write">+ 모임 만들기</a>
  </div>

  <hr class="my-4" />

  <!-- 모임 카드 목록 -->
  <div class="row g-3">
    <% if(meetings.length === 0) { %>
    <div class="col-12 text-center py-5">
      <p class="text-muted">현재 등록된 모임이 없습니다.</p>
    </div>
    <% } %>
    <% meetings.forEach(meeting => { %>
    <div class="col-md-6">
      <a href="/meeting/info/<%= meeting._id %>" class="text-decoration-none text-dark">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <h6 class="card-title mb-0"><%= meeting.title %></h6>
              <span class="chip chip-green"><span class="dot dot-green"></span><%= meeting.congestionLevel %></span>
            </div>
            <div class="small text-muted mb-2">
              📍 <%= meeting.area %> · <%= meeting.meetingDate ? new Date(meeting.meetingDate).toLocaleDateString() : '' %> · 
              <%= meeting.participants.length %>/<%= meeting.maxParticipants %>명
            </div>
            <p class="small mb-2 text-truncate"><%= meeting.content %></p>
            <div>
              <% meeting.tags.forEach(tag => { %>
              <span class="tag-soft"><%= tag %></span>
              <% }) %>
            </div>
          </div>
        </div>
      </a>
    </div>
    <% }) %>
  </div>

  <!-- 페이징 -->
  <% if(totalPages > 1) { %>
  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <% for(let i=1; i<=totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="/meeting/list?page=<%= i %>"><%= i %></a>
      </li>
      <% } %>
    </ul>
  </nav>
  <% } %>
</main>

<%- include('../partials/footer') %>
