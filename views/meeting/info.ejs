<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>장소 상세 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

<!-- 헤더 -->
<%- include('../partials/header') %>
<main class="container my-4">
  <%
    let chipClass = 'chip-green';
    let dotClass = 'dot-green';
    if (meeting.congestionLevel === '혼잡' || meeting.congestionLevel === '붐빔' || meeting.congestionLevel === '약간 붐빔') { 
      chipClass = 'chip-red'; 
      dotClass = 'dot-red'; 
    } else if (meeting.congestionLevel === '보통') { 
      chipClass = 'chip-yellow'; 
      dotClass = 'dot-yellow'; 
    }
  %>
  <a href="/meeting/list" class="text-decoration-none text-muted small mb-3 d-inline-block">← 목록으로</a>
  <div class="row g-4">
    <div class="col-lg-8">
      <article class="card shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <h3 class="mb-1"><%= meeting.title %></h3>
              <div class="small text-muted">
                주최자: <strong><%= meeting.author.nickname %></strong>
                <span class="badge bg-light text-dark ms-1" style="border: 1px solid #ddd;">
                  <%= meeting.author.manner_score.toFixed(1) %>°C
                </span> · 
                작성일: <%= new Date(meeting.createdAt).toLocaleDateString() %>
              </div>
            </div>
            <span class="chip <%= chipClass %>">📍 <%= meeting.area %> · <%= meeting.congestionLevel %></span>
          </div>

          <!-- 모임 정보 요약 -->
          <div class="row g-2 mb-4">
            <!-- 장소 -->
            <div class="col-md-4">
              <div class="p-3 rounded" style="background:var(--surface2);">
                <div class="small text-muted">장소</div>
                <div class="fw-bold text-brand"><%= meeting.area %></div>
              </div>
            </div>
            <!-- 일시 -->
            <div class="col-md-4">
              <div class="p-3 rounded" style="background:var(--surface2);">
                <div class="small text-muted">일시</div>
                <div class="fw-bold">
                  <%= new Date(meeting.meetingDate).toLocaleDateString() %>
                  <%= new Date(meeting.meetingDate).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                </div>
              </div>
            </div>
            <!-- 인원 -->
            <div class="col-md-4">
              <div class="p-3 rounded" style="background:var(--surface2);">
                <div class="small text-muted">인원</div>
                <div class="fw-bold">
                  <span class="text-brand"><%= meeting.participants.length %></span> / <%= meeting.maxParticipants %>명
                </div>
              </div>
            </div>
          </div>

          <div class="post-content fs-5 mb-4">
            <div class="ratio ratio-16x9 mb-3" style="max-width: 600px;">
              <img src="/images/upload/<%= meeting.imageUrl %>" 
              onerror="this.onerror=null; this.src='https://placehold.co/500x300/e0e0e0/666666?text=No+Image';"
              class="rounded" 
              style="object-fit: cover;" 
              alt="모임 이미지">
            </div>
            <div class="alert mb-4 p-3" style="background:var(--brand-50); border:1px solid var(--brand-border); color:var(--ink); border-radius: 12px;">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <strong class="fs-6">📎 자동 첨부된 장소 정보</strong>
                <a href="/feed/list?place_name=<%= encodeURIComponent(meeting.area) %>" class="small text-decoration-none" style="color:var(--brand); font-weight: 600;">제보 더보기 →</a>
              </div>
              
              <div class="d-flex gap-2 flex-wrap mb-3">
                <span class="chip <%= chipClass %>" title="혼잡도"><span class="dot <%= dotClass %>"></span> <%= meeting.congestionLevel %></span>
                <span class="chip chip-brand">📍 <%= meeting.area %></span>
                <% if (parkingCount > 0) { %>
                  <span class="chip chip-soft">🚗 주차장 <%= parkingCount %></span>
                <% } %>
                <% if (restroomCount > 0) { %>
                  <span class="chip chip-soft">🚻 화장실 <%= restroomCount %></span>
                <% } %>
              </div>

              <!-- 실시간 제보 섹션 (내부로 통합) -->
              <div id="realtime-reports-container" class="bg-white bg-opacity-50 rounded p-2" style="max-height: 200px; overflow-y: auto; border: 1px dashed var(--brand-border);">
                <% if (recentFeeds && recentFeeds.length > 0) { %>
                  <% recentFeeds.forEach(feed => { %>
                    <div class="report-item p-2 mb-1 bg-white rounded shadow-xs small border-bottom">
                      <div class="d-flex justify-content-between mb-0">
                        <span class="fw-bold" style="font-size: 0.8rem;"><%= feed.author.avatar_emoji %> <%= feed.author.nickname %></span>
                        <span class="text-muted" style="font-size: 0.7rem;">
                          <%= new Date(feed.createdAt).toLocaleDateString('ko-KR', {month: 'long', day: 'numeric'}) %>
                          <%= new Date(feed.createdAt).toLocaleTimeString('ko-KR', {hour: '2-digit', minute:'2-digit', hour12: true}) %>
                        </span>
                      </div>
                      <p class="mb-0 text-truncate" style="font-size: 0.85rem;"><%= feed.content %></p>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div id="no-reports-msg" class="text-center py-2 text-muted small">현재 이 장소에 등록된 제보가 없습니다.</div>
                <% } %>
              </div>
            </div>

            <%= meeting.content %>
          </div>

          <div class="mb-4">
            <% meeting.tags.forEach(tag => { %>
            <span class="tag-soft">#<%= tag %></span>
            <% }) %>
          </div>

          <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/meeting/list">목록으로</a>
            <% if(user && user.id === meeting.author._id.toString()) { %>
            <a class="btn btn-brand" href="/meeting/modify/<%= meeting._id %>">수정</a>
            <form action="/meeting/delete/<%= meeting._id %>" method="post" onsubmit="return confirm('정말 삭제하시겠습니까?')">
              <button type="submit" class="btn btn-outline-danger">삭제</button>
            </form>
            <% } %>
          </div>
        </div>
      </article>

      <!-- 참여자 목록 section -->
      <section class="mt-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>참여자 (<%= meeting.participants.length %> / <%= meeting.maxParticipants %>)</h5>
            <ul class="list-group list-group-flush">
              <% meeting.participants.forEach(p => { %>
                <li class="list-group-item d-flex align-items-center gap-3 px-0">
                  <div style="font-size: 1.5rem;"><%= p.avatar_emoji %></div>
                  <div>
                    <strong><%= p.nickname %>
                      <% if(p._id.toString() === meeting.author._id.toString()) { %>
                        <span class="badge bg-brand small text-dark">주최자</span>
                      <% } %>
                    </strong>
                    <div class="small text-muted">매너온도 <%= p.manner_score.toFixed(1) %>°C</div>
                  </div>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>
      </section>

      <!-- 댓글 섹션 -->
      <section class="mt-5">
        <h5 class="mb-3">댓글</h5>
        
        <ul class="list-group mb-4">
          <% if(comments.length === 0) { %>
          <li class="list-group-item text-center text-muted py-4">아직 댓글이 없습니다.</li>
          <% } %>
          <% comments.forEach(comment => { %>
          <li class="list-group-item p-3">
            <div class="d-flex justify-content-between mb-1">
              <span class="fw-bold">
                <%= comment.author.avatar_emoji %> <%= comment.author.nickname %>
                <span class="badge bg-light text-dark ms-1" style="border: 1px solid #ddd;">
                <%= comment.author.manner_score.toFixed(1) %>°C</span>
                <% if(comment.author._id.toString() === meeting.author._id.toString()) { %>
                <span class="badge bg-brand small ms-1 text-dark" style="font-size: 0.7rem;">주최자</span>
                <% } %>
              </span>
              
              <span class="small text-muted ms-auto"><%= new Date(comment.createdAt).toLocaleString() %></span>
              
            </div>
            <p class="mb-1"><%= comment.content %></p>
            <% if(user && user.id === comment.author._id.toString()) { %>
            <form action="/comment/delete" method="POST" class="text-end">
              <input type="hidden" name="commentId" value="<%= comment._id %>">
              <input type="hidden" name="boardId" value="<%= meeting._id %>">
              <input type="hidden" name="onModel" value="Meeting">
              <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" type="submit">삭제</button>
            </form>
            <% } %>
          </li>
          <% }) %>
        </ul>

        <!-- 댓글 페이지네이션 UI -->
        <% if (totalCommentPages > 1) { %>
        <nav aria-label="Comment navigation" class="mb-4">
            <ul class="pagination pagination-sm justify-content-center">
              <% for(let i = 1; i <= totalCommentPages; i++) { %>
                <li class="page-item <%= currentCommentPage === i ? 'active' : '' %>">
                  <a class="page-link" href="?commentPage=<%= i %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
          <% } %>
    
        <!-- 댓글 작성 -->
        <% if(user) { %>
        <div class="card">
          <div class="card-body">
            <form action="/comment/write" method="POST" onsubmit="disableSubmitButton(this)">
              <input type="hidden" name="boardId" value="<%= meeting._id %>">
              <input type="hidden" name="onModel" value="Meeting">
              <div class="mb-3">
                <textarea name="content" class="form-control" rows="3" placeholder="댓글을 입력하세요" required></textarea>
              </div>
              <button type="submit" class="btn btn-brand">댓글 등록</button>
            </form>
            <script>
              function disableSubmitButton(form) {
                const btn = form.querySelector('button[type="submit"]');
                btn.disabled = true; // 버튼 비활성화
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>등록 중..'; // 로딩
              }
            </script>
          </div>
        </div>
        <% } %>
      </section>
    </div>

    <!-- 오른쪽: 참여 신청 사이드바 -->
    <div class="col-lg-4">
      <div class="card shadow-sm sticky-top" style="top: 20px;">
        <div class="card-body">
          <h5 class="mb-3">참여 신청</h5>
          <!-- 인원 현황 프로그레스 바 -->
          <div class="mb-3 p-3 rounded bg-light">
            <div class="small text-muted">현재 모집 인원</div>
            <h4><span style="color:var(--brand);"><%= meeting.participants.length %></span> / <%= meeting.maxParticipants %>명</h4>
            <div class="progress mt-2" style="height: 6px;">

              <% 
                let percent = (meeting.participants.length / meeting.maxParticipants) * 100; 
                let barStyle = `width: ${percent}%; background-color: var(--brand);`;
              %>
              <div class="progress-bar" style="<%= barStyle %>" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          </div>
          <% if (!user) { %>
          <!-- 로그인 안 한 경우 -->
          <div class="d-grid">
            <a href="/member/login" class="btn btn-outline-secondary btn-lg">로그인 후 참여 가능</a>
          </div>
          <% } else if (user.id === meeting.author._id.toString()) { %>
          <!-- 주최자인 경우 -->
          <div class="alert alert-info text-center">내가 만든 모임입니다.</div>
          <% } else { %>
            <!-- 일반 사용자 (참여/취소 버튼) -->
            <form action="/meeting/join/<%= meeting._id %>" method="post">
              <div class="d-grid">
                <% if (meeting.participants.some(p => p._id.toString() === user.id)) { %>
                  <button type="submit" class="btn btn-outline-danger btn-lg">참여 취소하기</button>
                <% } else if (meeting.status === 'full') { %>
                  <button type="button" class="btn btn-secondary btn-lg" disabled>모집 마감</button>
                <% } else { %>
                  <button type="submit" class="btn btn-brand btn-lg">참여 신청하기</button>
                <% } %>
              </div>
            </form>
            <hr>
            <div class="small text-muted">
              모임 24시간 전까지 취소 가능합니다<br>
              매너 있는 모임 문화를 위해 노쇼에 주의해 주세요.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>


<!-- 푸터 -->
		<%- include('../partials/footer') %>
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                // Socket.IO 실시간 제보 업데이트 로직
                document.addEventListener('DOMContentLoaded', () => {
                    const area = "<%= meeting.area %>";
                    const container = document.getElementById('realtime-reports-container');
                    const noReportsMsg = document.getElementById('no-reports-msg');

                    if (typeof socket !== 'undefined' && area) {
                        // 해당 지역 방에 입장
                        socket.emit("joinDistrict", area);

                        // 새로운 제보 수신 시 UI 업데이트
                        socket.on("newReportInDistrict", (data) => {
                            if (noReportsMsg) noReportsMsg.remove();

                            const dateObj = new Date(data.createdAt);
                            const dateStr = dateObj.toLocaleDateString('ko-KR', {month: 'long', day: 'numeric'});
                            const timeStr = dateObj.toLocaleTimeString('ko-KR', {hour: '2-digit', minute:'2-digit', hour12: true});
                            
                            const reportHtml = `
                                <div class="report-item p-2 mb-1 bg-white rounded shadow-xs small border-bottom animate__animated animate__fadeInDown">
                                    <div class="d-flex justify-content-between mb-0">
                                        <span class="fw-bold" style="font-size: 0.8rem;">${data.authorEmoji} ${data.authorNickname}</span>
                                        <span class="text-muted" style="font-size: 0.7rem;">${dateStr} ${timeStr}</span>
                                    </div>
                                    <p class="mb-0 text-truncate" style="font-size: 0.85rem;">${data.content}</p>
                                </div>
                            `;
                            
                            container.insertAdjacentHTML('afterbegin', reportHtml);

                            // 최대 5개 유지 (선택사항)
                            const items = container.getElementsByClassName('report-item');
                            if (items.length > 5) {
                                container.removeChild(items[items.length - 1]);
                            }
                        });
                    }
                });
            </script>
  </body>
</html>
