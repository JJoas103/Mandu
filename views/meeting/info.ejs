    <!-- 헤더 -->
	<%- include('../partials/header') %>

		<!-- 메인 -->
		<main class="container my-4">
			<article class="card shadow-sm">
				<div class="card-body p-4">
					<h3 class="mb-2">
						<%= board.title %>
					</h3>
					<div class="small text-muted mb-3">작성자: <%= board.author.name %> · 작성일: <%=
								board.createdAt.toLocaleDateString() %>
					</div>

					<% if(board.file) { %>
						<img alt="게시판 이미지" src="/images/upload/<%=board.file %>" class="img-fluid mb-3">
						<% } else { %>
							<div class="placeholder-img mb-3" style="height: 280px;">이미지 없음</div>
							<% } %>

								<div class="post-content">
									<%= board.content %>
								</div>
								<div class="mt-4 d-flex gap-2">
									<a class="btn btn-outline-secondary" href="#">목록</a>
									<a class="btn btn-brand" href="/feed/modify/<%=board.id%>">수정</a>
									<a class="btn btn-brand" href="/feed/delete/<%=board.id%>">삭제</a>
								</div>
				</div>
			</article>

			<!-- 댓글 섹션  -->
			<section class="mt-5">
				<h5 class="mb-3">댓글</h5>

				<!-- 댓글 10개 (더미) -->
				<ul class="list-group mb-4">
					<% comments.forEach(comment=> { %>
						<li class="list-group-item">
							<strong>
								<%= comment.author.name %>
							</strong><span class="small text-muted"> · <%= comment.createdAt.toLocaleDateString() %>
							</span>
							<p class="mt-2 mb-0">
								<%= comment.content %>
							</p>

							<!-- 로그인한 사용자와 댓글 작성자가 일치해야만 삭제 버튼이 화면에 출력 -->
							<% if(user && user.id.toString()===comment.author.id.toString()) { %>
								<form action="/comment/delete" method="POST">
									<input type="hidden" name="commentId" value="<%= comment.id %>">
									<input type="hidden" name="boardId" value="<%= board.id %>">
									<button class="btn btn-sm btn-outline-danger mt-1" type="submit">삭제</button>
								</form>
								<% } %>

						</li>
						<% }); %>
				</ul>

				<!-- 페이징 -->
				<nav aria-label="댓글 페이지" class="mt-3">
					<ul class="pagination justify-content-center">
						<!-- 이전 -->
						<li class="page-item <%= currentCommentPage === 1 ? 'disabled' : '' %>">
							<a class="page-link"
								href="/feed/info/<%= board._id %>?commentPage=<%= currentCommentPage - 1 %>">이전</a>
						</li>

						<!-- 페이지 번호 -->
						<% for (let i=1; i <=totalCommentPages; i++) { %>
							<li class="page-item <%= currentCommentPage === i ? 'active' : '' %>">
								<a class="page-link" href="/feed/info/<%= board._id %>?commentPage=<%= i %>">
									<%= i %>
								</a>
							</li>
							<% } %>

								<!-- 다음 -->
								<li class="page-item <%= currentCommentPage === totalCommentPages ? 'disabled' : '' %>">
									<a class="page-link"
										href="/feed/info/<%= board._id %>?commentPage=<%= currentCommentPage + 1 %>">다음</a>
								</li>
					</ul>
				</nav>

				<!-- 댓글 작성 폼 -->
				<div class="card mt-4">
					<div class="card-body">
						<h6 class="card-title mb-3">댓글 작성</h6>

						<form action="/comment/write/<%=board.id%>" method="POST">
							<div class="mb-3">
								<textarea name="content" class="form-control" rows="3"
									placeholder="댓글을 입력하세요"></textarea>
							</div>
							<button type="submit" class="btn btn-brown">등록</button>
						</form>

					</div>
				</div>
			</section>

		</main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
