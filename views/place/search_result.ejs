<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>검색 결과 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<%- include('../partials/header') %>

	<main class="container my-4">
		<a href="/" class="text-decoration-none text-muted small mb-3 d-inline-block">← 지도로 돌아가기</a>
		<!-- 제목 조건 처리 -->
		<% if (keyword === '전체 장소' || keyword === '한산한 명소') { %>
			<h4 class="mb-4"><%= keyword %> — <%= results.length %>곳</h4>
		<% } else { %>
			<h4 class="mb-4">"<%= keyword %>" 검색 결과 — <%= results.length %>곳</h4>
		<% } %>

		<div class="row g-3">
			<% if (results.length === 0) { %>
				<div class="col-12 text-center py-5 text-muted">
					<h4>검색된 장소가 없습니다.</h4>
					<p>다른 검색어로 다시 시도해 보세요.</p>
				</div>
			<% } else { %>
				<% results.forEach(function(place) { %>
					<div class="col-md-4 col-6">
					<a href="/place/<%= place.area_cd %>" class="text-decoration-none text-dark">
						<div class="card h-100 shadow-sm">
							<% if (place.imageUrl) { %>
								<img src="<%= place.imageUrl %>" class="card-img-top" style="height:120px;object-fit:cover;" alt="<%= place.name %>">
							<% } else { %>
								<div class="placeholder-img">🌳</div>
							<% } %>
							<div class="card-body">
								<h6 class="card-title mb-1"><%= place.name %></h6>
								<% if (place.congest_lvl === '여유') { %>
									<span class="chip chip-green"><span class="dot dot-green"></span> <%= place.congest_lvl %></span>
								<% } else if (place.congest_lvl === '보통') { %>
									<span class="chip chip-yellow"><span class="dot dot-yellow"></span> <%= place.congest_lvl %></span>
								<% } else { %>
									<span class="chip chip-red"><span class="dot dot-red"></span> <%= place.congest_lvl %></span>
								<% } %>
							</div>
						</div>
					</a>
				</div>
			<% }) %>
			<% } %>
		</div>
	</main>

	<%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
