<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>장소 상세 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">

		<!-- 뒤로가기 -->
		<a href="index.html" class="text-decoration-none text-muted small mb-3 d-inline-block">← 지도로 돌아가기</a>

		<!-- 장소 헤더 -->
		<div class="card shadow-sm mb-4">
			<div class="card-body p-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
				<div>
					<div class="small text-muted mb-1">마포구 · 연남동 일대</div>
					<h2 class="mb-2">연남동 🌳</h2>
					<div class="d-flex gap-2 flex-wrap">
						<span class="chip chip-green"><span class="dot dot-green"></span> 현재 여유</span>
						<span class="chip chip-brand">🅿️ 주차 가능</span>
						<span class="chip chip-blue">🚻 화장실 5곳</span>
					</div>
				</div>
				<a href="meeting_write.html?place_id=1" class="btn btn-brand btn-lg">이 장소에서 모임 만들기</a>
			</div>
		</div>

		<div class="row g-4">
			<!-- 왼쪽: 혼잡도 + 인프라 -->
			<div class="col-lg-8">

				<!-- 실시간 혼잡도 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body p-4">
						<div class="small text-muted mb-2">실시간 혼잡도</div>
						<div class="d-flex align-items-center gap-2 mb-2">
							<h3 class="mb-0 text-success">여유</h3>
							<span class="chip chip-green">지금 적합</span>
						</div>
						<p class="text-muted mb-0">현재 방문자 수가 평소보다 적음 — 모임하기 좋은 시간대입니다.</p>

						<!-- 시간대 혼잡도 바 -->
						<div class="hour-bars">
							<div class="hour-bar-wrap"><div class="hour-bar green"  style="height:25%"></div><div class="hour-label">9시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar green"  style="height:32%"></div><div class="hour-label">10시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar yellow" style="height:55%"></div><div class="hour-label">11시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar yellow" style="height:72%"></div><div class="hour-label">12시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar yellow" style="height:62%"></div><div class="hour-label">13시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar green active" style="height:34%"></div><div class="hour-label fw-bold" style="color:var(--brand);">지금</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar red"    style="height:86%"></div><div class="hour-label">15시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar red"    style="height:94%"></div><div class="hour-label">16시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar yellow" style="height:68%"></div><div class="hour-label">17시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar yellow" style="height:50%"></div><div class="hour-label">18시</div></div>
							<div class="hour-bar-wrap"><div class="hour-bar green"  style="height:28%"></div><div class="hour-label">19시</div></div>
						</div>
					</div>
				</div>

				<!-- 인프라 카드 (주차장, 화장실, 대중교통, 날씨) -->
				<div class="row g-3 mb-3">
					<div class="col-md-6">
						<div class="card shadow-sm h-100">
							<div class="card-body">
								<div style="font-size:22px;">🅿️</div>
								<div class="small text-muted fw-bold mt-1">공영 주차장</div>
								<h3 class="text-success mb-0">잔여 23</h3>
								<div class="small text-muted">250m 이내 · 3곳</div>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="card shadow-sm h-100">
							<div class="card-body">
								<div style="font-size:22px;">🚻</div>
								<div class="small text-muted fw-bold mt-1">개방 화장실</div>
								<h3 class="text-success mb-0">5곳</h3>
								<div class="small text-muted">반경 500m 이내</div>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="card shadow-sm h-100">
							<div class="card-body">
								<div style="font-size:22px;">🚌</div>
								<div class="small text-muted fw-bold mt-1">대중교통</div>
								<h5 class="mb-0">홍대입구역</h5>
								<div class="small text-muted">도보 8분</div>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="card shadow-sm h-100">
							<div class="card-body">
								<div style="font-size:22px;">🌤️</div>
								<div class="small text-muted fw-bold mt-1">오늘 날씨</div>
								<h3 class="text-warning mb-0">21°C</h3>
								<div class="small text-muted">맑음 · 습도 45%</div>
							</div>
						</div>
					</div>
				</div>

				<!-- 이 장소 모임 목록 -->
				<div class="card shadow-sm">
					<div class="card-body p-4">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h5 class="mb-0">📌 이 장소 모임</h5>
							<a href="meeting_write.html?place_id=1" class="btn btn-sm btn-brand">+ 모임 만들기</a>
						</div>
						<ul class="list-group list-group-flush">
							<li class="list-group-item px-0">
								<a href="meeting_info.html?meeting_id=1" class="text-decoration-none text-dark">
									<div class="d-flex justify-content-between align-items-center">
										<div>
											<strong>연남동 산책 + 카페 탐방</strong>
											<div class="small text-muted mt-1">오늘 15:00 · <span class="tag-soft">조용한카페</span> <span class="tag-soft">주차가능</span></div>
										</div>
										<span class="small text-muted">2/5명</span>
									</div>
								</a>
							</li>
							<li class="list-group-item px-0">
								<a href="meeting_info.html?meeting_id=3" class="text-decoration-none text-dark">
									<div class="d-flex justify-content-between align-items-center">
										<div>
											<strong>경의선 숲길 저녁 산책</strong>
											<div class="small text-muted mt-1">내일 19:00 · <span class="tag-soft">야외활동</span></div>
										</div>
										<span class="small text-muted">1/4명</span>
									</div>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- 오른쪽: 주변 편의시설 + 실시간 제보 + 방문 인증 -->
			<div class="col-lg-4">

				<!-- 주변 편의시설 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body">
						<h6 class="card-title mb-3">☕ 주변 편의시설</h6>
						<ul class="list-group list-group-flush">
							<li class="list-group-item px-0 d-flex justify-content-between align-items-center">
								<div>
									<div><span class="me-2">☕</span><strong>연남동 카페거리</strong></div>
									<div class="small text-muted">카페 밀집 · 야외 좌석 다수</div>
								</div>
								<span class="small text-primary">120m</span>
							</li>
							<li class="list-group-item px-0 d-flex justify-content-between align-items-center">
								<div>
									<div><span class="me-2">🍜</span><strong>경의선 숲길 맛집거리</strong></div>
									<div class="small text-muted">음식점 30+</div>
								</div>
								<span class="small text-primary">200m</span>
							</li>
							<li class="list-group-item px-0 d-flex justify-content-between align-items-center">
								<div>
									<div><span class="me-2">🏪</span><strong>GS25 연남점</strong></div>
									<div class="small text-muted">편의점 · 24시간</div>
								</div>
								<span class="small text-primary">80m</span>
							</li>
						</ul>
					</div>
				</div>

				<!-- 실시간 제보 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body">
						<h6 class="card-title mb-3">📡 실시간 제보</h6>
						<div class="d-flex gap-2 mb-2">
							<div class="feed-avatar">🧑</div>
							<div>
								<strong class="small">user_42</strong>
								<div class="text-muted" style="font-size:11px;">3분 전</div>
							</div>
						</div>
						<p class="small mb-2">경의선 숲길 쪽은 지금 한산해요. 카페 자리도 넉넉합니다 👍</p>
						<a href="feed_list.html?place_id=1" class="small text-decoration-none" style="color:var(--brand);">제보 더 보기 →</a>
					</div>
				</div>

				<!-- 방문 인증 & 찜하기 -->
				<div class="d-grid gap-2">
					<!-- 방문 인증 모달 트리거 -->
					<button type="button" class="btn btn-brand btn-lg" data-bs-toggle="modal" data-bs-target="#verifyModal">
						📍 방문 인증하기
					</button>
					<form action="/favorite/add" method="post">
						<input type="hidden" name="place_id" value="1">
						<button type="submit" class="btn btn-outline-brand w-100">⭐ 찜한 장소에 추가</button>
					</form>
				</div>
			</div>
		</div>
	</main>

	<!-- 방문 인증 모달 -->
	<div class="modal fade" id="verifyModal" tabindex="-1">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">방문 인증 📍</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body text-center">
					<p class="text-muted">현재 위치를 확인하고 인증합니다</p>
					<div class="p-3 rounded" style="background:var(--brand-50); border:1px solid var(--brand-border);">
						<h5 class="mb-1">연남동</h5>
						<div class="small" style="color:var(--brand);">GPS: 37.5614° N, 126.9244° E</div>
					</div>
				</div>
				<div class="modal-footer">
					<form action="/visit/verify" method="post" class="w-100">
						<input type="hidden" name="place_id" value="1">
						<input type="hidden" name="gps_latitude"  value="37.5614">
						<input type="hidden" name="gps_longitude" value="126.9244">
						<button type="submit" class="btn btn-brand w-100">인증하기 (+2 매너점수)</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<!-- 푸터 -->
    <%- include('partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
