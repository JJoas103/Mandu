<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= place.name %> - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">

		<!-- 뒤로가기 -->
		<a href="/" class="text-decoration-none text-muted small mb-3 d-inline-block">← 지도로 돌아가기</a>

		<!-- 장소 헤더 -->
		<div class="card shadow-sm mb-4">
			<% if (placeImage) { %>
				<img src="<%= placeImage %>" class="card-img-top" style="height:200px;object-fit:cover;" alt="<%= place.name %>">
			<% } %>
			<div class="card-body p-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
				<div>
					<div class="small text-muted mb-1"><%= place.category || '서울 주요 명소' %></div>
					<h2 class="mb-2"><%= place.name %></h2>
					<div class="d-flex gap-2 flex-wrap">
						<% if (place.congest_lvl === '여유') { %>
							<span class="chip chip-green"><span class="dot dot-green"></span> 현재 여유</span>
						<% } else if (place.congest_lvl === '보통') { %>
							<span class="chip chip-yellow"><span class="dot dot-yellow"></span> 현재 보통</span>
						<% } else if (place.congest_lvl === '약간 붐빔') { %>
							<span class="chip chip-yellow"><span class="dot dot-yellow"></span> 현재 약간 붐빔</span>
						<% } else if (place.congest_lvl === '혼잡') { %>
							<span class="chip chip-red"><span class="dot dot-red"></span> 현재 혼잡</span>
						<% } %>
						<% if (parkingInfo.length > 0) { %>
							<span class="chip chip-brand">🅿️ 주차 <%= parkingInfo.length %>곳</span>
						<% } %>
						<% if (restroomInfo.length > 0) { %>
							<span class="chip chip-blue">🚻 화장실 <%= restroomInfo.length %>곳</span>
						<% } %>
					</div>
				</div>
				<div class="d-flex flex-column gap-2 align-items-end">
					<a href="/meeting/write?area=<%= encodeURIComponent(place.name) %>" class="btn btn-brand btn-lg">이 장소에서 모임 만들기</a>
					<% if (user) { %>
						<% if (isFavorite) { %>
							<form action="/favorite/delete" method="post" class="w-100">
								<input type="hidden" name="place_id" value="<%= place.area_cd %>">
								<button type="submit" class="btn btn-success btn-lg w-100" onclick="return confirm('찜한 장소에서 삭제하시겠습니까?')">✅ 이미 찜한 장소</button>
							</form>
						<% } else { %>
							<form action="/favorite/add" method="post" id="favoriteForm" class="w-100">
								<input type="hidden" name="place_id" value="<%= place.area_cd %>">
								<input type="hidden" name="reason" id="favoriteReason">
								<button type="button" onclick="handleFavorite()" class="btn btn-outline-brand btn-lg w-100">⭐ 찜한 장소에 추가</button>
							</form>
						<% } %>
					<% } else { %>
						<a href="/member/login" class="btn btn-outline-brand btn-lg w-100">⭐ 찜하기 (로그인 필요)</a>
					<% } %>
				</div>
			</div>
		</div>

		<div class="row g-4">
			<!-- 왼쪽: 혼잡도 + 인프라 -->
			<div class="col-lg-8">

				<!-- 실시간 혼잡도 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body p-4">
						<div class="small text-muted mb-2">실시간 혼잡도</div>
						<div class="d-flex align-items-center gap-2 mb-2">
							<% if (place.congest_lvl === '여유') { %>
								<h3 class="mb-0 text-success"><%= place.congest_lvl %></h3>
								<span class="chip chip-green">지금 적합</span>
							<% } else if (place.congest_lvl === '보통') { %>
								<h3 class="mb-0 text-warning"><%= place.congest_lvl %></h3>
								<span class="chip chip-yellow">보통 수준</span>
							<% } else { %>
								<h3 class="mb-0 text-danger"><%= place.congest_lvl %></h3>
								<span class="chip chip-red">혼잡 주의</span>
							<% } %>
						</div>
						<p class="text-muted mb-0">서울 실시간 도시데이터 기준 혼잡도입니다.</p>
					</div>
				</div>

				<!-- 주차장 정보 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body p-4">
						<h5 class="mb-3">🅿️ 주변 주차장 <span class="text-muted fs-6 fw-normal">(반경 500m)</span></h5>
						<% if (parkingInfo.length > 0) { %>
							<ul class="list-group list-group-flush">
								<% parkingInfo.forEach(function(p) { %>
									<li class="list-group-item px-0 d-flex justify-content-between align-items-center">
										<div>
											<div class="fw-semibold"><%= p.place_name %></div>
											<div class="small text-muted"><%= p.road_address_name || p.address_name %></div>
										</div>
										<% if (p.distance) { %>
											<span class="small text-primary"><%= p.distance %>m</span>
										<% } %>
									</li>
								<% }) %>
							</ul>
						<% } else { %>
							<p class="text-muted mb-0">반경 500m 이내 주차장 정보가 없습니다.</p>
						<% } %>
					</div>
				</div>

				<!-- 화장실 정보 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body p-4">
						<h5 class="mb-3">🚻 주변 화장실 <span class="text-muted fs-6 fw-normal">(반경 500m)</span></h5>
						<% if (restroomInfo.length > 0) { %>
							<ul class="list-group list-group-flush">
								<% restroomInfo.forEach(function(r) { %>
									<li class="list-group-item px-0 d-flex justify-content-between align-items-center">
										<div>
											<div class="fw-semibold"><%= r.place_name %></div>
											<div class="small text-muted"><%= r.road_address_name || r.address_name %></div>
										</div>
										<% if (r.distance) { %>
											<span class="small text-primary"><%= r.distance %>m</span>
										<% } %>
									</li>
								<% }) %>
							</ul>
						<% } else { %>
							<p class="text-muted mb-0">반경 500m 이내 화장실 정보가 없습니다.</p>
						<% } %>
					</div>
				</div>

				<!-- 이 장소 모임 목록 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body p-4">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h5 class="mb-0">📌 이 장소 모임</h5>
							<a href="/meeting/write?area=<%= encodeURIComponent(place.name) %>" class="btn btn-sm btn-brand">+ 모임 만들기</a>
						</div>
						<% if (meetings.length > 0) { %>
							<ul class="list-group list-group-flush">
								<% meetings.forEach(function(m) { %>
									<li class="list-group-item px-0">
										<a href="/meeting/info/<%= m._id %>" class="text-decoration-none text-dark">
											<div class="d-flex justify-content-between align-items-center">
												<div>
													<strong><%= m.title %></strong>
													<div class="small text-muted mt-1">
														<%= m.status === 'recruit' ? '모집중' : '마감' %>
														<% if (m.author) { %> · <%= m.author.nickname %><% } %>
													</div>
												</div>
												<span class="small text-muted"><%= m.participants ? m.participants.length : 0 %>/<%= m.maxParticipants %>명</span>
											</div>
										</a>
									</li>
								<% }) %>
							</ul>
						<% } else { %>
							<p class="text-muted mb-0">이 장소에 등록된 모임이 없습니다.</p>
						<% } %>
					</div>
				</div>
			</div>

			<!-- 오른쪽: 날씨 + 대중교통 + 찜하기 + 방문 인증 -->
			<div class="col-lg-4">

				<!-- 날씨 카드 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body">
						<div style="font-size:22px;">🌤️</div>
						<div class="small text-muted fw-bold mt-1">오늘 날씨</div>
						<% if (weather) { %>
							<h3 class="text-warning mb-0"><%= weather.tempC %>°C</h3>
							<div class="small text-muted"><%= weather.desc %></div>
						<% } else { %>
							<div class="small text-muted mt-1">날씨 정보를 불러올 수 없습니다</div>
						<% } %>
					</div>
				</div>

				<!-- 대중교통 카드 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body">
						<div style="font-size:22px;">🚌</div>
						<div class="small text-muted fw-bold mt-1">가까운 대중교통</div>
						<% if (transitInfo) { %>
							<h5 class="mb-0 mt-1"><%= transitInfo.name %></h5>
							<div class="small text-muted"><%= transitInfo.type %> · <%= transitInfo.distance %>m</div>
						<% } else { %>
							<div class="small text-muted mt-1">주변 대중교통 정보가 없습니다</div>
						<% } %>
					</div>
				</div>

				<!-- 소형 카카오 지도 -->
				<div class="card shadow-sm mb-3">
					<div class="card-body p-2">
						<h6 class="mb-2 px-2 pt-1">📍 위치</h6>
						<div id="placeMap" style="width:100%;height:200px;border-radius:8px;"></div>
					</div>
				</div>

				<!-- 방문 인증 & 제보 -->
				<div class="d-grid gap-2">
					<button type="button" class="btn btn-brand btn-lg" id="visitBtn"
						data-logged-in="<%= user ? 'true' : 'false' %>"
						data-place-id="<%= place.area_cd %>"
						data-place-name="<%= place.name %>">
						📍 방문 인증하기
					</button>
					<a href="/feed/write?place_id=<%= encodeURIComponent(place.area_cd) %>&place_name=<%= encodeURIComponent(place.name) %>"
						class="btn btn-outline-secondary w-100">📡 이 장소 실시간 제보하기</a>
				</div>
			</div>
		</div>
	</main>

	<!-- 방문 인증 모달 -->
	<div class="modal fade" id="verifyModal" tabindex="-1">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">방문 인증 📍</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body text-center">
					<div id="verifyDefault">
						<p class="text-muted">현재 위치를 확인하고 인증합니다</p>
						<div class="p-3 rounded" style="background:var(--brand-50); border:1px solid var(--brand-border);">
							<h5 class="mb-1"><%= place.name %></h5>
							<div class="small" style="color:var(--brand);">GPS: <%= place.latitude %>° N, <%= place.longitude %>° E</div>
						</div>
					</div>
					<div id="verifyResult" class="d-none"></div>
				</div>
				<div class="modal-footer" id="verifyFooter">
					<button type="button" class="btn btn-brand w-100" id="confirmVisitBtn">인증하기 (+2 매너점수)</button>
				</div>
			</div>
		</div>
	</div>

	<!-- 푸터 -->
    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="//dapi.kakao.com/v2/maps/sdk.js?appkey=<%= process.env.KAKAO_MAP_API %>"></script>
	<script>
		// 소형 지도 초기화
		(function() {
			const mapContainer = document.getElementById('placeMap');
			const mapOption = {
				center: new kakao.maps.LatLng(<%= place.latitude %>, <%= place.longitude %>),
				level: 4
			};
			const map = new kakao.maps.Map(mapContainer, mapOption);
			const marker = new kakao.maps.Marker({
				position: new kakao.maps.LatLng(<%= place.latitude %>, <%= place.longitude %>)
			});
			marker.setMap(map);
		})();
	</script>
	<script>
		const visitBtn = document.getElementById('visitBtn');
		const isLoggedIn = visitBtn.dataset.loggedIn === 'true';
		const placeId = visitBtn.dataset.placeId;
		const placeName = visitBtn.dataset.placeName;

		visitBtn.addEventListener('click', function () {
			if (!isLoggedIn) {
				showToast('로그인이 필요합니다.', 'danger');
				return;
			}
			resetModal();
			new bootstrap.Modal(document.getElementById('verifyModal')).show();
		});

		document.getElementById('confirmVisitBtn').addEventListener('click', async function () {
			this.disabled = true;
			this.textContent = '인증 중...';

			try {
				const res = await fetch('/visit/verify', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ place_id: placeId, place_name: placeName })
				});
				const data = await res.json();

				document.getElementById('verifyDefault').classList.add('d-none');
				document.getElementById('verifyFooter').classList.add('d-none');
				const resultEl = document.getElementById('verifyResult');
				resultEl.classList.remove('d-none');

				if (data.success) {
					resultEl.innerHTML = `<div class="text-success fs-5 mb-2">✅ ${data.message}</div>
						<div class="text-muted small">현재 매너 점수: <strong>${data.newScore}</strong></div>`;
					setTimeout(() => bootstrap.Modal.getInstance(document.getElementById('verifyModal')).hide(), 2000);
				} else {
					resultEl.innerHTML = `<div class="text-danger fs-6">⚠️ ${data.message}</div>`;
					document.getElementById('verifyFooter').classList.remove('d-none');
					this.disabled = false;
					this.textContent = '인증하기 (+2 매너점수)';
				}
			} catch (e) {
				document.getElementById('verifyResult').innerHTML = '<div class="text-danger">오류가 발생했습니다. 다시 시도해 주세요.</div>';
				this.disabled = false;
				this.textContent = '인증하기 (+2 매너점수)';
			}
		});

		function resetModal() {
			document.getElementById('verifyDefault').classList.remove('d-none');
			document.getElementById('verifyResult').classList.add('d-none');
			document.getElementById('verifyResult').innerHTML = '';
			document.getElementById('verifyFooter').classList.remove('d-none');
			const btn = document.getElementById('confirmVisitBtn');
			btn.disabled = false;
			btn.textContent = '인증하기 (+2 매너점수)';
		}

		function showToast(message, type) {
			const toast = document.createElement('div');
			toast.className = `position-fixed bottom-0 start-50 translate-middle-x mb-4 alert alert-${type} shadow`;
			toast.style.cssText = 'z-index:9999; min-width:220px; text-align:center;';
			toast.textContent = message;
			document.body.appendChild(toast);
			setTimeout(() => toast.remove(), 2500);
		}

		function handleFavorite() {
			const reason = prompt("이 장소를 찜하는 이유를 입력해주세요 (예: 한산해서 좋아요, 풍경이 예뻐요):");
			if (reason === null) return;
			if (reason.trim() === "") {
				alert("이유를 입력해야 찜할 수 있습니다.");
				return;
			}
			document.getElementById('favoriteReason').value = reason;
			document.getElementById('favoriteForm').submit();
		}
	</script>
</body>
</html>
