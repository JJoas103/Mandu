<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>로그인 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<%- include('../partials/header') %>

<main class="container my-4">
  <!-- 프로필 카드 -->
  <div class="card shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-md-auto text-center">
          <div class="position-relative d-inline-block">
            <% if(user.provider === 'google' || user.provider === 'naver' || user.profileImage.startsWith('http')) { %>
              <img src="<%= user.profileImage %>" alt="프로필" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
            <% } else { %>
              <img src="/images/profile/<%= user.profileImage %>" alt="프로필" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
            <% } %>
            <span class="position-absolute bottom-0 end-0 bg-white rounded-circle p-1 shadow-sm" style="font-size: 24px;"><%= user.avatar_emoji %></span>
          </div>
        </div>
        <div class="col-md">
          <h4 class="mb-1"><%= user.nickname %></h4>
          <div class="small text-muted mb-2">📍 <%= user.city %> · <%= user.address || '주소 미설정' %></div>
          <div class="d-flex gap-4">
            <div class="text-center">
              <div class="fw-bold fs-4"><%= meetingCount %></div>
              <div class="small text-muted">모임</div>
            </div>
            <div class="text-center">
              <div class="fw-bold fs-4"><%= feedCount %></div>
              <div class="small text-muted">제보</div>
            </div>
          </div>
        </div>
        <div class="col-md-auto">
          <div class="d-flex flex-column gap-2">
            <a href="/member/modify" class="btn btn-outline-brand btn-sm">회원정보 수정</a>
            <a href="#" class="btn btn-outline-brand btn-sm">찜·알림</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <!-- 매너점수 -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title mb-3">⭐ 매너 점수</h6>
          <div class="d-flex justify-content-between align-items-end mb-2">
            <div>
              <h1 class="mb-0 text-success"><%= user.manner_score %></h1>
              <div class="small text-muted">상위 15% · 매너왕 근접</div>
            </div>
            <span class="chip chip-green">↑ +2.1 이번주</span>
          </div>
          <div class="manner-bar-bg mt-3">
            <div class="manner-bar-fill" style="width: <%= user.manner_score %>%;"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 최근 활동 (더미데이터 유지) -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title mb-3">📍 최근 활동</h6>
          <ul class="list-group list-group-flush">
            <li class="list-group-item px-0 d-flex align-items-center gap-2">
              <span style="font-size:20px;">🌳</span>
              <div class="flex-grow-1">
                <div class="fw-bold small">연남동 방문 인증</div>
                <div class="text-muted" style="font-size:11px;">오늘 14:23</div>
              </div>
            </li>
            <li class="list-group-item px-0 d-flex align-items-center gap-2">
              <span style="font-size:20px;">🤝</span>
              <div class="flex-grow-1">
                <div class="fw-bold small">새로운 모임 가입</div>
                <div class="text-muted" style="font-size:11px;">어제 11:05</div>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- 회원 탈퇴 -->
  <div class="text-end">
    <a href="/member/delete" class="small text-muted text-decoration-none">회원 탈퇴</a>
  </div>
</main>

<%- include('../partials/footer') %>
