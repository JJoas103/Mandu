<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>마이페이지 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">

		<!-- 프로필 카드 -->
		<div class="card shadow-sm mb-4">
			<div class="card-body p-4">
				<div class="row align-items-center g-3">
					<div class="col-md-auto text-center">
						<div class="rounded-circle d-inline-flex align-items-center justify-content-center"
							style="width:80px; height:80px; font-size:36px; background:var(--brand-50); border:2px solid var(--brand-border);">
							<%= user && user.avatar_emoji ? user.avatar_emoji : '😊' %>
						</div>
					</div>
					<div class="col-md">
						<h4 class="mb-1"><%= user ? user.nickname : '로그인 필요' %></h4>
						<div class="small text-muted mb-2">@<%= user ? user.nickname : 'guest' %> · <%= user && user.city ? user.city : '서울' %></div>
						<div class="d-flex gap-4">
							<div class="text-center">
								<div class="fw-bold fs-4">0</div>
								<div class="small text-muted">모임</div>
							</div>
							<div class="text-center">
								<div class="fw-bold fs-4">0</div>
								<div class="small text-muted">제보</div>
							</div>
							<div class="text-center">
								<div class="fw-bold fs-4">0</div>
								<div class="small text-muted">방문지</div>
							</div>
						</div>
					</div>
					<div class="col-md-auto">
						<div class="d-flex gap-2 flex-wrap">
							<a href="/member/modify" class="btn btn-outline-brand btn-sm">⚙️ 정보 수정</a>
							<a href="/member/favorites" class="btn btn-outline-brand btn-sm">⭐ 찜·알림</a>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row g-3 mb-3">
			<!-- 매너점수 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<h6 class="card-title mb-3">⭐ 매너 점수</h6>
						<div class="d-flex justify-content-between align-items-end mb-2">
							<div>
								<h1 class="mb-0 text-success">50.0</h1>
								<div class="small text-muted">새내기 모여봄 회원</div>
							</div>
							<span class="chip chip-green">정상</span>
						</div>
						<div class="manner-bar-bg mt-3">
							<div class="manner-bar-fill" style="width: 50%;"></div>
						</div>
					</div>
				</div>
			</div>

			<!-- 방문 기록 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h6 class="card-title mb-0">📍 방문 기록</h6>
							<a href="#" class="small text-decoration-none" style="color:var(--brand);">전체보기</a>
						</div>
						<div class="text-center py-4 text-muted">
                            방문 기록이 없습니다. <br> 장소를 방문하고 인증을 남겨보세요!
                        </div>
					</div>
				</div>
			</div>
		</div>

		<!-- 획득 배지 -->
		<div class="card shadow-sm mb-3">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h6 class="card-title mb-0">🏅 획득 배지</h6>
					<span class="small text-muted">0 / 8 획득</span>
				</div>
				<div class="badge-grid">
					<div class="badge-item locked">
						<div class="badge-emoji">🌳</div>
						<div class="badge-name">연남동 정복</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">☕</div>
						<div class="badge-name">카페 탐험가</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">📡</div>
						<div class="badge-name">첫 제보</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">🤝</div>
						<div class="badge-name">모임 주최 5회</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">🏙️</div>
						<div class="badge-name">서울 탐험가</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">⭐</div>
						<div class="badge-name">매너왕</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">🗺️</div>
						<div class="badge-name">25개 구 완주</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">🌟</div>
						<div class="badge-name">레전드</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row g-3 mb-3">
			<!-- 참여중인 모임 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<h6 class="card-title mb-3">🤝 참여중인 모임</h6>
						<div class="text-center py-3 text-muted">
                            참여중인 모임이 없습니다.
                        </div>
					</div>
				</div>
			</div>

			<!-- 내가 제보한 글 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<h6 class="card-title mb-3">📡 내가 제보한 글</h6>
						<div class="text-center py-3 text-muted">
                            제보한 글이 없습니다.
                        </div>
					</div>
				</div>
			</div>
		</div>

		<!-- 방문한 지역 -->
		<div class="card shadow-sm mb-3">
			<div class="card-body">
				<h6 class="card-title mb-3">🗺️ 방문한 지역</h6>
				<div class="text-center py-3 text-muted">
                    아직 방문한 지역이 없습니다.
                </div>
			</div>
		</div>

		<!-- 회원 탈퇴 -->
		<div class="text-end">
			<a href="/member/delete" class="small text-muted text-decoration-none">회원 탈퇴</a>
		</div>
	</main>

    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
