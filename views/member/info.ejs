	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">

		<!-- 프로필 카드 -->
		<div class="card shadow-sm mb-4">
			<div class="card-body p-4">
				<div class="row align-items-center g-3">
					<div class="col-md-auto text-center">
						<% if(user.provider === 'google' || user.provider === 'naver') {%>
					<img src="<%= user.profileImage %>" alt="프로필 이미지" class="rounded-circle mb-3"
					style="width: 120px; height: 120px; object-fit: cover;">
				<% }else{ %>
					<img src="/images/profile/<%= user.profileImage %>" alt="프로필 이미지" class="rounded-circle mb-3"
						style="width: 120px; height: 120px; object-fit: cover;">
				<% } %>
					</div>
					<div class="col-md">
						<h4 class="mb-1"><%= user.name %></h4>
						<div class="small text-muted mb-2">@<%= user.name %> · <%= user.address %></div>
						<div class="d-flex gap-4">
							<div class="text-center">
								<div class="fw-bold fs-4"><%= meetingCount %></div>
								<div class="small text-muted">모임</div>
							</div>
							<div class="text-center">
								<div class="fw-bold fs-4"><%= feedCount %></div>
								<div class="small text-muted">제보</div>
							</div>
							<div class="text-center">
								<div class="fw-bold fs-4"><%= boardCount %></div>
								<div class="small text-muted">방문지</div>
							</div>
						</div>
					</div>
					<div class="col-md-auto">
						<div class="d-flex flex-column gap-2 flex-wrap">
							<a href="/member/modify" class="btn btn-outline-brand btn-sm">회원정보 수정</a>
							<a href="member_favorites.html" class="btn btn-outline-brand btn-sm">찜·알림</a>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row g-3 mb-3">
			<!-- 매너점수 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<h6 class="card-title mb-3">⭐ 매너 점수</h6>
						<div class="d-flex justify-content-between align-items-end mb-2">
							<div>
								<h1 class="mb-0 text-success">87.4</h1>
								<div class="small text-muted">상위 15% · 매너왕 근접</div>
							</div>
							<span class="chip chip-green">↑ +2.1 이번주</span>
						</div>
						<div class="manner-bar-bg mt-3">
							<div class="manner-bar-fill" style="width: 87%;"></div>
						</div>
					</div>
				</div>
			</div>

			<!-- 방문 기록 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h6 class="card-title mb-0">📍 방문 기록</h6>
							<a href="#" class="small text-decoration-none" style="color:var(--brand);">전체보기</a>
						</div>
						<ul class="list-group list-group-flush">
							<li class="list-group-item px-0 d-flex align-items-center gap-2">
								<span style="font-size:20px;">🌳</span>
								<div class="flex-grow-1">
									<div class="fw-bold small">연남동 방문 인증</div>
									<div class="text-muted" style="font-size:11px;">오늘 14:23</div>
								</div>
								<span class="small fw-bold text-success">+2</span>
							</li>
							<li class="list-group-item px-0 d-flex align-items-center gap-2">
								<span style="font-size:20px;">🏘️</span>
								<div class="flex-grow-1">
									<div class="fw-bold small">서래마을 방문 인증</div>
									<div class="text-muted" style="font-size:11px;">어제 11:05</div>
								</div>
								<span class="small fw-bold text-success">+1</span>
							</li>
							<li class="list-group-item px-0 d-flex align-items-center gap-2">
								<span style="font-size:20px;">🎋</span>
								<div class="flex-grow-1">
									<div class="fw-bold small">익선동 방문 인증</div>
									<div class="text-muted" style="font-size:11px;">3일 전 16:40</div>
								</div>
								<span class="small fw-bold text-success">+2</span>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<!-- 획득 배지 -->
		<div class="card shadow-sm mb-3">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h6 class="card-title mb-0">🏅 획득 배지</h6>
					<span class="small text-muted">4 / 8 획득</span>
				</div>
				<div class="badge-grid">
					<div class="badge-item earned">
						<div class="badge-emoji">🌳</div>
						<div class="badge-name">연남동 정복</div>
					</div>
					<div class="badge-item earned">
						<div class="badge-emoji">☕</div>
						<div class="badge-name">카페 탐험가</div>
					</div>
					<div class="badge-item earned">
						<div class="badge-emoji">📡</div>
						<div class="badge-name">첫 제보</div>
					</div>
					<div class="badge-item earned">
						<div class="badge-emoji">🤝</div>
						<div class="badge-name">모임 주최 5회</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">🏙️</div>
						<div class="badge-name">서울 탐험가</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">⭐</div>
						<div class="badge-name">매너왕</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">🗺️</div>
						<div class="badge-name">25개 구 완주</div>
					</div>
					<div class="badge-item locked">
						<div class="badge-emoji">🌟</div>
						<div class="badge-name">레전드</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row g-3 mb-3">
			<!-- 참여중인 모임 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<h6 class="card-title mb-3">🤝 참여중인 모임</h6>
						<ul class="list-group list-group-flush">
							<li class="list-group-item px-0">
								<a href="meeting_info.html?meeting_id=1" class="text-decoration-none text-dark">
									<div class="fw-bold small">연남동 산책 + 카페 탐방</div>
									<div class="text-muted small">오늘 15:00 · 주최자</div>
								</a>
							</li>
							<li class="list-group-item px-0">
								<a href="meeting_info.html?meeting_id=4" class="text-decoration-none text-dark">
									<div class="fw-bold small">서울숲 피크닉</div>
									<div class="text-muted small">토요일 14:00 · 참여자</div>
								</a>
							</li>
							<li class="list-group-item px-0">
								<a href="meeting_info.html?meeting_id=9" class="text-decoration-none text-dark">
									<div class="fw-bold small">한강 자전거 라이딩</div>
									<div class="text-muted small">일요일 08:00 · 참여자</div>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- 내가 제보한 글 -->
			<div class="col-md-6">
				<div class="card shadow-sm h-100">
					<div class="card-body">
						<h6 class="card-title mb-3">📡 내가 제보한 글</h6>
						<ul class="list-group list-group-flush">
							<li class="list-group-item px-0">
								<a href="feed_info.html?feed_id=1" class="text-decoration-none text-dark">
									<div class="d-flex justify-content-between">
										<span class="fw-bold small">경의선 숲길 쪽은 지금 한산해요...</span>
										<span class="small text-muted">3분 전</span>
									</div>
									<div class="small" style="color:var(--brand);">👍 12 · 💬 3</div>
								</a>
							</li>
							<li class="list-group-item px-0">
								<a href="feed_info.html?feed_id=5" class="text-decoration-none text-dark">
									<div class="d-flex justify-content-between">
										<span class="fw-bold small">성수동 카페거리 지금 대기 길어요</span>
										<span class="small text-muted">2일 전</span>
									</div>
									<div class="small" style="color:var(--brand);">👍 8 · 💬 2</div>
								</a>
							</li>
							<li class="list-group-item px-0">
								<a href="feed_info.html?feed_id=7" class="text-decoration-none text-dark">
									<div class="d-flex justify-content-between">
										<span class="fw-bold small">잠실 롯데월드 주차장 거의 만차</span>
										<span class="small text-muted">5일 전</span>
									</div>
									<div class="small" style="color:var(--brand);">👍 15 · 💬 4</div>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<!-- 방문한 지역 -->
		<div class="card shadow-sm mb-3">
			<div class="card-body">
				<h6 class="card-title mb-3">🗺️ 방문한 지역 (24곳)</h6>
				<div class="d-flex flex-wrap gap-2">
					<span class="tag-soft">🌳 연남동</span>
					<span class="tag-soft">🏘️ 서래마을</span>
					<span class="tag-soft">🎋 익선동</span>
					<span class="tag-soft">🌸 성수동</span>
					<span class="tag-soft">🏯 북촌</span>
					<span class="tag-soft">🌳 서울숲</span>
					<span class="tag-soft">🍜 을지로</span>
					<span class="tag-soft">🏙️ 잠실</span>
					<span class="tag-soft">🎨 문래동</span>
					<span class="tag-soft">🌊 한강공원</span>
					<span class="tag-soft">🛍️ 홍대</span>
					<span class="tag-soft">☕ 합정</span>
					<span class="tag-soft">+ 12곳 더</span>
				</div>
			</div>
		</div>

		<!-- 회원 탈퇴 -->
		<div class="text-end">
			<a href="/member/delete" class="small text-muted text-decoration-none">회원 탈퇴</a>
		</div>
	</main>

    <!-- 푸터 -->
    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
