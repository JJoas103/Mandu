<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>로그인 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<%- include('../partials/header') %>

<main class="container my-4">
  <!-- 프로필 카드 -->
  <div class="card shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-md-auto text-center">
          <div class="position-relative d-inline-block">
            <% if(user.profileImage && !user.profileImage.startsWith('http') && user.profileImage !== 'default-profile.png') { %>
              <img src="/images/profile/<%= user.profileImage %>" alt="프로필" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
            <% } else { %>
              <img src="/images/profile/default-profile.png" alt="프로필" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover; background-color: #f8f9fa;">
            <% } %>
            <span class="position-absolute bottom-0 end-0 bg-white rounded-circle p-1 shadow-sm" style="font-size: 24px;"><%= user.avatar_emoji %></span>
          </div>
        </div>
        <div class="col-md">
          <h4 class="mb-1"><%= user.nickname %></h4>
          <div class="small text-muted mb-2">📍 <%= user.city %> · <%= user.address || '주소 미설정' %></div>
          <div class="d-flex gap-4">
            <div class="text-center cursor-pointer" onclick="toggleSection('meetings')" style="cursor: pointer;">
              <div class="fw-bold fs-4"><%= meetingCount %></div>
              <div class="small text-muted">모임</div>
            </div>
            <div class="text-center cursor-pointer" onclick="toggleSection('feeds')" style="cursor: pointer;">
              <div class="fw-bold fs-4"><%= feedCount %></div>
              <div class="small text-muted">제보</div>
            </div>
          </div>
        </div>
        <div class="col-md-auto">
          <div class="d-flex flex-column gap-2">
            <a href="/member/modify" class="btn btn-outline-brand btn-sm">회원정보 수정</a>
            <a href="/member/favorites" class="btn btn-outline-brand btn-sm position-relative">
              ⭐ 찜·알림
              <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                  <span class="visually-hidden">새 알림</span>
                </span>
              <% } %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 내 모임 목록 섹션 (초기 숨김) -->
  <div id="my-meetings-section" class="mb-4" style="display: none;">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="card-title mb-0">🤝 내가 참여 중인 모임</h6>
          <button type="button" class="btn-close" onclick="toggleSection('meetings')"></button>
        </div>
        <div class="row g-3">
          <% if(myMeetings && myMeetings.length > 0) { %>
            <% myMeetings.forEach(meeting => { %>
              <div class="col-md-6">
                <a href="/meeting/info/<%= meeting._id %>" class="text-decoration-none text-dark">
                  <div class="card h-100 border-0 bg-light">
                    <div class="card-body p-3">
                      <div class="d-flex justify-content-between mb-1">
                        <span class="fw-bold small text-truncate"><%= meeting.title %></span>
                        <span class="badge bg-white text-success border border-success small"><%= meeting.congestionLevel %></span>
                      </div>
                      <div class="text-muted" style="font-size: 12px;">
                        📍 <%= meeting.area %> · <%= new Date(meeting.meetingDate).toLocaleDateString() %>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center py-4">
              <p class="text-muted mb-0">참여 중인 모임이 없습니다.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- 내 제보 목록 섹션 (초기 숨김) -->
  <div id="my-feeds-section" class="mb-4" style="display: none;">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="card-title mb-0">📡 내가 작성한 제보</h6>
          <button type="button" class="btn-close" onclick="toggleSection('feeds')"></button>
        </div>
        <div class="row g-3">
          <% if(myFeeds && myFeeds.length > 0) { %>
            <% myFeeds.forEach(feed => { %>
              <div class="col-md-4">
                <a href="/feed/info/<%= feed._id %>" class="text-decoration-none text-dark">
                  <div class="card h-100 border-0 bg-light overflow-hidden">
                    <% if(feed.image) { %>
                      <img src="/images/upload/<%= feed.image %>" class="card-img-top" style="height: 100px; object-fit: cover;">
                    <% } %>
                    <div class="card-body p-2">
                      <p class="small text-truncate mb-1"><%= feed.content %></p>
                      <div class="text-muted" style="font-size: 11px;">📍 <%= feed.locationTag %></div>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center py-4">
              <p class="text-muted mb-0">작성한 제보가 없습니다.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <!-- 매너점수 -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title mb-3">⭐ 매너 점수</h6>
          <div class="d-flex justify-content-between align-items-end mb-2">
            <div>
              <h1 class="mb-0 text-success"><%= user.manner_score.toFixed(1) %></h1>
              <div class="small text-muted"><%= user.manner_score >= 80 ? '상위 5% · 매너왕' : (user.manner_score >= 60 ? '상위 15% · 우수 활동자' : '일반 등급') %></div>
            </div>
            <span class="chip chip-green">점수 현황</span>
          </div>
          <div class="manner-bar-bg mt-3 mb-4">
            <div class="manner-bar-fill" style="width: <%= user.manner_score %>%;"></div>
          </div>

          <!-- 점수 변동 내역 -->
          <div class="score-history mt-4">
            <h6 class="small fw-bold text-muted mb-2">최근 점수 변동</h6>
            <ul class="list-group list-group-flush">
              <% if (scoreActivities && scoreActivities.length > 0) { %>
                <% scoreActivities.forEach(item => { %>
                  <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center" style="font-size: 13px;">
                    <span class="text-truncate" style="max-width: 70%;"><%= item.message %></span>
                    <span class="fw-bold <%= item.scoreChange > 0 ? 'text-success' : 'text-danger' %>">
                      <%= item.scoreChange > 0 ? '+' : '' %><%= item.scoreChange %>
                    </span>
                  </li>
                <% }) %>
              <% } else { %>
                <li class="list-group-item px-0 py-2 text-center text-muted small">점수 변동 내역이 없습니다.</li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- 최근 활동 -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title mb-3">📍 최근 활동</h6>
          <ul class="list-group list-group-flush">
            <% if (activities && activities.length > 0) { %>
              <% activities.forEach(activity => { %>
                <li class="list-group-item px-0 d-flex align-items-center gap-2">
                  <span style="font-size:20px;">
                    <% 
                      let icon = '⭐';
                      if (activity.type === 'meeting_join') icon = '🤝';
                      else if (activity.type === 'meeting_create') icon = '🆕';
                      else if (activity.type === 'visit_verify') icon = '🌳';
                      else if (activity.type === 'feed_write') icon = '📡';
                      else if (activity.type === 'like_received') icon = '👍';
                      else if (activity.type === 'comment_write') icon = '💬';
                    %>
                    <%= icon %>
                  </span>
                  <div class="flex-grow-1">
                    <div class="fw-bold small">
                      <% if (activity.relatedLink) { %>
                        <a href="<%= activity.relatedLink %>" class="text-decoration-none text-dark"><%= activity.message %></a>
                      <% } else { %>
                        <%= activity.message %>
                      <% } %>
                    </div>
                    <div class="text-muted" style="font-size:11px;">
                      <% 
                        const diff = new Date() - new Date(activity.createdAt);
                        const mins = Math.floor(diff / 60000);
                        const hours = Math.floor(mins / 60);
                        const days = Math.floor(hours / 24);
                        let timeStr = '';
                        if (days > 0) timeStr = `${days}일 전`;
                        else if (hours > 0) timeStr = `${hours}시간 전`;
                        else if (mins > 0) timeStr = `${mins}분 전`;
                        else timeStr = '방금 전';
                      %>
                      <%= timeStr %>
                    </div>
                  </div>
                </li>
              <% }) %>
            <% } else { %>
              <li class="list-group-item px-0 text-center py-4 text-muted small">최근 활동이 없습니다.</li>
            <% } %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- 획득 배지 -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h6 class="card-title mb-3">🏅 획득 배지</h6>
      <div class="badge-grid d-flex flex-wrap gap-3 justify-content-start text-center">
        <% 
          // 기본 배지 목록
          const baseBadges = [
            { id: 'yeonnam', name: '연남동 정복', emoji: '🌳' },
            { id: 'cafe', name: '카페 탐험가', emoji: '☕' },
            { id: 'first_feed', name: '첫 제보', emoji: '📡' },
            { id: 'seoul', name: '서울 탐험가', emoji: '🏙️' },
            { id: 'districts', name: '25개 구 완주', emoji: '🗺️' },
            { id: 'legend', name: '레전드', emoji: '🌟' }
          ];

          // 매너 점수 배지 카테고리
          let mannerBadge = null;
          if (user.manner_score >= 100) mannerBadge = { name: '금배지', emoji: '🥇' };
          else if (user.manner_score >= 90) mannerBadge = { name: '은배지', emoji: '🥈' };
          else if (user.manner_score >= 80) mannerBadge = { name: '동배지', emoji: '🥉' };

          // 모임 활동 배지 카테고리
          let meetingBadge = null;
          if (meetingCount >= 15) meetingBadge = { name: '활발한 활동', emoji: '🔥' };
          else if (meetingCount >= 10) meetingBadge = { name: '성실한 활동', emoji: '🏅' };
          else if (meetingCount >= 7) meetingBadge = { name: '꾸준한 활동', emoji: '🌱' };

          const userBadges = user.badges || [];
          
          // 표시할 배지 목록 구성 (획득한 배지만 필터링)
          const displayBadges = baseBadges
            .filter(b => userBadges.includes(b.id))
            .map(b => ({ ...b, earned: true }));
            
          if (mannerBadge) displayBadges.push({ ...mannerBadge, earned: true });
          if (meetingBadge) displayBadges.push({ ...meetingBadge, earned: true });
        %>
        
        <% if (displayBadges.length > 0) { %>
          <% displayBadges.forEach(badge => { %>
            <div class="badge-item earned" style="width: 80px; flex-shrink: 0;">
              <div class="badge-emoji mb-1" style="font-size: 32px;"><%= badge.emoji %></div>
              <div class="badge-name small text-muted" style="font-size: 11px;"><%= badge.name %></div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center py-4">
            <p class="text-muted small mb-0">아직 획득한 배지가 없습니다. 활동을 통해 배지를 모아보세요!</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- 회원 탈퇴 -->
  <div class="text-end">
    <a href="/member/delete" class="small text-muted text-decoration-none">회원 탈퇴</a>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
  function toggleSection(type) {
    const meetingSection = document.getElementById('my-meetings-section');
    const feedSection = document.getElementById('my-feeds-section');

    if (type === 'meetings') {
      const isHidden = meetingSection.style.display === 'none';
      meetingSection.style.display = isHidden ? 'block' : 'none';
      feedSection.style.display = 'none'; // 제보 섹션은 닫기
      
      if(isHidden) meetingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (type === 'feeds') {
      const isHidden = feedSection.style.display === 'none';
      feedSection.style.display = isHidden ? 'block' : 'none';
      meetingSection.style.display = 'none'; // 모임 섹션은 닫기
      
      if(isHidden) feedSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>
</body>
</html>
