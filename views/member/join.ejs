<%- include('../partials/header') %>

<main class="container my-4">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h4 class="mb-3">회원가입</h4>

          <form action="/member/join" method="post" enctype="multipart/form-data">
            <div class="row g-3">
              <!-- 이메일 -->
              <div class="col-md-12">
                <label class="form-label">이메일 <span class="text-danger">*</span></label>
                <div class="input-group">
                  <input type="email" class="form-control" name="email" placeholder="이메일을 입력하세요" id="emailInput" required />
                  <button type="button" class="btn btn-outline-secondary" id="emailCheckBtn">중복확인</button>
                </div>
                <div id="emailFeedback" class="small mt-1"></div>
                <% if(errors.email){ %>
                <div class="form-text text-danger"><%= errors.email %></div>
                <% } %>
              </div>

              <!-- 비밀번호 -->
              <div class="col-md-12">
                <label class="form-label">비밀번호 <span class="text-danger">*</span></label>
                <input type="password" class="form-control" name="password" placeholder="비밀번호를 입력하세요" id="passwordInput" required />
                <small class="text-muted">영문, 숫자, 특수문자 조합 8자 이상</small>
                <% if(errors.password) { %>
                <div class="form-text text-danger"><%= errors.password %></div>
                <% } %>
              </div>

              <!-- 비밀번호 확인 -->
              <div class="col-md-12">
                <label class="form-label">비밀번호 확인 <span class="text-danger">*</span></label>
                <input type="password" class="form-control" name="password2" placeholder="비밀번호를 다시 입력하세요" id="passwordConfirmInput" required />
                <% if(errors.password2){ %>
                <div class="form-text text-danger"><%= errors.password2 %></div>
                <% } %>
              </div>

              <!-- 닉네임 -->
              <div class="col-12">
                <label class="form-label">닉네임 <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="nickname" placeholder="모임에서 사용할 닉네임" required />
                <% if(errors.nickname){ %>
                <div class="form-text text-danger"><%= errors.nickname %></div>
                <% } %>
              </div>

              <!-- 활동 지역 -->
              <div class="col-12">
                <label class="form-label">주 활동 지역</label>
                <select class="form-select" name="city">
                  <option value="서울">서울</option>
                  <option value="경기">경기</option>
                  <option value="인천">인천</option>
                  <option value="기타">기타</option>
                </select>
              </div>

              <!-- 상세 주소 -->
              <div class="col-12">
                <label class="form-label">상세 주소</label>
                <input type="text" class="form-control" name="address" placeholder="주소를 입력하세요" />
              </div>

              <!-- 프로필 이모지 -->
              <div class="col-12">
                <label class="form-label">프로필 이모지 (선택)</label>
                <input type="text" class="form-control" name="avatar_emoji" placeholder="😊" maxlength="2" />
                <div class="form-text">이모지 하나로 프로필을 표현해보세요</div>
              </div>

              <!-- 프로필 이미지 -->
              <div class="col-12">
                <label class="form-label">프로필 이미지</label>
                <input type="file" class="form-control" accept="image/*" name="uploadFile" />
              </div>
            </div>

            <div class="d-grid mt-4">
              <button type="submit" class="btn btn-brand btn-lg" id="submitBtn">가입하기</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
  const emailInput = document.getElementById("emailInput");
  const emailCheckBtn = document.getElementById("emailCheckBtn");
  const emailFeedback = document.getElementById("emailFeedback");
  const joinForm = document.querySelector("form");
  let isChecked = false;

  emailCheckBtn.addEventListener("click", async () => {
    const email = emailInput.value.trim();
    if(!email) return alert("이메일을 입력해주세요");
    try {
      const res = await fetch(`/member/check-email?email=${encodeURIComponent(email)}`);
      const data = await res.json();

      if (data.available) {
        emailFeedback.textContent = "사용 가능한 이메일입니다";
        emailFeedback.className = "small mt-1 text-success";
        isChecked = true;
      } else {
        emailFeedback.textContent = "이미 가입된 이메일입니다";
        emailFeedback.className = "small mt-1 text-danger";
        isChecked = false;
      }
    } catch (error) {
      emailFeedback.textContent = "서버 오류가 발생했습니다";
      emailFeedback.className = "small mt-1 text-danger";
    }
  });

  emailInput.addEventListener("input", () => {
    isChecked = false;
    emailFeedback.textContent = "";
  });

  joinForm.addEventListener("submit", (e) => {
    if (!isChecked) {
      e.preventDefault();
      alert("이메일 중복확인을 해주세요");
    }
  });
</script>
