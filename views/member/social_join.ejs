<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>소셜 계정 설정 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<%- include('../partials/header') %>

<main class="container my-4">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h4 class="mb-3">소셜 계정 설정</h4>
          <p class="text-muted small mb-4">서비스 이용을 위해 추가 정보를 입력해주세요. (이메일: <%= socialData.email %>)</p>

          <form action="/member/social-join" method="post" enctype="multipart/form-data">
            <div class="row g-3">
              <!-- 닉네임 -->
              <div class="col-12">
                <label class="form-label">닉네임 <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="nickname" value="<%= socialData.nickname %>" placeholder="모임에서 사용할 닉네임" required />
                <div class="form-text">다른 사용자와 중복되지 않는 닉네임을 설정해주세요.</div>
              </div>

              <!-- 활동 지역 -->
              <div class="col-12">
                <label class="form-label">주 활동 지역</label>
                <select class="form-select" name="city">
                  <option value="서울" selected>서울</option>
                  <option value="경기">경기</option>
                  <option value="인천">인천</option>
                  <option value="기타">기타</option>
                </select>
              </div>

              <!-- 상세 주소 -->
              <div class="col-12">
                <label class="form-label">상세 주소</label>
                <input type="text" class="form-control" name="address" placeholder="주소를 입력하세요" />
              </div>

              <!-- 프로필 이모지 -->
              <div class="col-12">
                <label class="form-label">프로필 이모지 (선택)</label>
                <input type="text" class="form-control" name="avatar_emoji" placeholder="😊" maxlength="2" />
                <div class="form-text">이모지 하나로 프로필을 표현해보세요</div>
              </div>

              <!-- 프로필 이미지 -->
              <div class="col-12">
                <label class="form-label">프로필 이미지</label>
                <input type="file" class="form-control" accept="image/*" name="uploadFile" />
                <div class="form-text">설정하지 않으면 기본 이미지가 사용됩니다.</div>
              </div>
            </div>

            <div class="d-grid mt-4">
              <button type="submit" class="btn btn-brand btn-lg">시작하기</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
