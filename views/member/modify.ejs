<%- include('../partials/header') %>

<main class="container my-4">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h4 class="mb-3">회원수정</h4>

          <form action="/member/modify" method="post" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-md-12">
                <label class="form-label">이메일</label>
                <input type="email" class="form-control" name="email" value="<%= user.email %>" readonly />
              </div>

              <!-- 비밀번호 -->
              <div class="col-md-12">
                <label class="form-label">새 비밀번호 (변경 시에만 입력)</label>
                <input type="password" class="form-control" name="password" placeholder="새 비밀번호를 입력하세요" />
              </div>

              <!-- 닉네임 -->
              <div class="col-12">
                <label class="form-label">닉네임 <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="nickname" value="<%= user.nickname %>" required />
              </div>

              <!-- 활동 지역 -->
              <div class="col-12">
                <label class="form-label">주 활동 지역</label>
                <select class="form-select" name="city">
                  <option value="서울" <%= user.city === '서울' ? 'selected' : '' %>>서울</option>
                  <option value="경기" <%= user.city === '경기' ? 'selected' : '' %>>경기</option>
                  <option value="인천" <%= user.city === '인천' ? 'selected' : '' %>>인천</option>
                  <option value="기타" <%= user.city === '기타' ? 'selected' : '' %>>기타</option>
                </select>
              </div>

              <!-- 상세 주소 -->
              <div class="col-12">
                <label class="form-label">상세 주소</label>
                <input type="text" class="form-control" name="address" value="<%= user.address %>" />
              </div>

              <!-- 프로필 이모지 -->
              <div class="col-12">
                <label class="form-label">프로필 이모지</label>
                <input type="text" class="form-control" name="avatar_emoji" value="<%= user.avatar_emoji %>" maxlength="2" />
              </div>

              <!-- 프로필 이미지 -->
              <div class="col-12">
                <label class="form-label">프로필 이미지 변경</label>
                <input type="file" class="form-control" accept="image/*" name="uploadFile" />
              </div>
            </div>

            <div class="d-grid mt-4">
              <button type="submit" class="btn btn-brand">수정하기</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
