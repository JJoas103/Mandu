<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= title %> - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
	<style>
		/* 알림 체크박스 강조 */
		.noti-checkbox {
			width: 1.25rem;
			height: 1.25rem;
			cursor: pointer;
			border: 2px solid #adb5bd;
		}
		.noti-checkbox:checked {
			background-color: #ff6b6b; /* 브랜드 컬러 예시 */
			border-color: #ff6b6b;
		}
		.form-check-input#selectAllNoti {
			width: 1.1rem;
			height: 1.1rem;
			border: 2px solid #adb5bd;
		}
	</style>
</head>
<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">

		<a href="/member/info" class="text-decoration-none text-muted small mb-3 d-inline-block">← 마이페이지로</a>

		<h4 class="mb-4">⭐ 찜한 장소 · 알림 설정</h4>

		<div class="row g-3">

			<!-- 찜한 장소 목록 -->
			<div class="col-lg-8">
				<div class="card shadow-sm">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h6 class="card-title mb-0">찜한 장소 (<%= places.length %>곳)</h6>
							<small class="text-muted">혼잡도 변화 시 알림</small>
						</div>

						<% if (places.length > 0) { %>
                            <div class="row g-3 mb-4">
                                <% places.forEach(function(place) { %>
                                    <div class="col-12">
                                        <div class="d-flex align-items-center gap-3 p-3 border rounded bg-white shadow-sm">
                                            <!-- 왼쪽: 이미지 -->
                                            <div style="flex-shrink: 0;">
                                                <% if (place.imageUrl) { %>
                                                    <img src="<%= place.imageUrl %>" class="rounded" style="width: 70px; height: 70px; object-fit: cover;" alt="<%= place.name %>">
                                                <% } else { %>
                                                    <div class="rounded d-flex align-items-center justify-content-center bg-light text-muted" style="width: 70px; height: 70px; font-size: 24px;">🌳</div>
                                                <% } %>
                                            </div>
                                            
                                            <!-- 중간 왼쪽: 장소 이름 & 상태 -->
                                            <div style="width: 140px;">
                                                <div class="fw-bold text-truncate" title="<%= place.name %>"><%= place.name %></div>
                                                <div class="badge <%= place.congest_lvl === '여유' ? 'bg-success' : (place.congest_lvl === '보통' ? 'bg-warning' : 'bg-danger') %> mt-1">
                                                    <%= place.congest_lvl %>
                                                </div>
                                            </div>

                                            <!-- 중간 중심: 찜한 이유 (가운데 강조) -->
                                            <div class="flex-grow-1 text-center border-start border-end px-3">
                                                <div class="small text-muted mb-1" style="font-size: 11px;">나의 찜 이유</div>
                                                <div class="fw-semibold text-brand text-break">"<%= place.reason || '좋아하는 장소에요' %>"</div>
                                            </div>

                                            <!-- 오른쪽: 버튼 -->
                                            <div class="d-flex flex-column gap-1" style="width: 70px; flex-shrink: 0;">
                                                <a href="/place/<%= place.area_cd %>" class="btn btn-sm btn-outline-brand">이동</a>
                                                <form action="/favorite/delete" method="post">
                                                    <input type="hidden" name="place_id" value="<%= place.area_cd %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100" onclick="return confirm('찜을 해제하시겠습니까?')">삭제</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5 text-muted">
                                찜 한 장소가 없습니다. <br> 장소 탐색에서 마음에 드는 곳을 추가해 보세요!
                            </div>
                        <% } %>

						<div class="text-center mt-3">
							<a href="/" class="btn btn-outline-brand">+ 장소 찜하러 가기</a>
						</div>
					</div>
				</div>

				<!-- 알림 내역 -->
				<div class="card shadow-sm mt-3">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h6 class="card-title mb-0">💬 알림 내역</h6>
							<% if (notifications && notifications.length > 0) { %>
								<div class="form-check small">
									<input class="form-check-input" type="checkbox" id="selectAllNoti">
									<label class="form-check-label text-muted" for="selectAllNoti">전체선택</label>
								</div>
							<% } %>
						</div>
						
						<% if (notifications && notifications.length > 0) { %>
							<div class="list-group list-group-flush border-top border-bottom mb-3" id="notiList">
								<% notifications.forEach(function(noti) { %>
									<div class="list-group-item px-0 py-3 <%= noti.isRead ? 'opacity-50' : '' %>" data-id="<%= noti._id %>" data-read="<%= noti.isRead %>">
										<div class="d-flex align-items-start gap-3">
											<div class="form-check mt-1">
												<input class="form-check-input noti-checkbox" type="checkbox" value="<%= noti._id %>">
											</div>
											<a href="<%= noti.relatedLink || '#' %>" class="text-decoration-none flex-grow-1">
												<div class="d-flex justify-content-between align-items-start">
													<div>
														<div class="d-flex align-items-center gap-2 mb-1">
															<% if (noti.type === 'like') { %>
																<span class="badge bg-success-subtle text-success">추천</span>
															<% } else if (noti.type === 'comment') { %>
																<span class="badge bg-primary-subtle text-primary">댓글</span>
															<% } else { %>
																<span class="badge bg-secondary-subtle text-secondary">알림</span>
															<% } %>
															<small class="text-muted"><%= new Date(noti.createdAt).toLocaleString() %></small>
															<% if (!noti.isRead) { %>
																<span class="badge bg-danger rounded-pill" style="font-size: 8px;">N</span>
															<% } %>
														</div>
														<div class="text-dark"><%= noti.message %></div>
													</div>
													<span class="text-muted small">〉</span>
												</div>
											</a>
										</div>
									</div>
								<% }); %>
							</div>

							<!-- 페이징 및 관리 버튼 -->
							<div class="d-flex justify-content-between align-items-start mt-3">
								<!-- 페이징 -->
								<nav aria-label="Notification pagination">
									<ul class="pagination pagination-sm mb-0">
										<li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
											<a class="page-link" href="?page=<%= currentPage - 1 %>">이전</a>
										</li>
										<% for(let i = 1; i <= totalPages; i++) { %>
											<li class="page-item <%= currentPage === i ? 'active' : '' %>">
												<a class="page-link" href="?page=<%= i %>"><%= i %></a>
											</li>
										<% } %>
										<li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
											<a class="page-link" href="?page=<%= currentPage + 1 %>">다음</a>
										</li>
									</ul>
								</nav>

								<!-- 관리 버튼 -->
								<div class="d-flex gap-1">
									<button type="button" class="btn btn-sm btn-outline-secondary" onclick="markAsRead()">읽음</button>
									<button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteSelected()">삭제</button>
									<button type="button" class="btn btn-sm btn-danger" onclick="deletePageRead()">전체삭제</button>
								</div>
							</div>
						<% } else { %>
							<div class="text-center py-5 text-muted">
								새로운 알림이 없습니다.
							</div>
						<% } %>
					</div>
				</div>
			</div>

			<!-- 알림 설정 -->
			<div class="col-lg-4">
				<div class="card shadow-sm">
					<div class="card-body">
						<h6 class="card-title mb-3">🔔 알림 설정</h6>

						<form action="/member/notify-settings" method="post">

							<div class="mb-3">
								<label class="form-label small fw-bold">혼잡도 알림 조건</label>
								<select class="form-select form-select-sm" name="congestion_alert">
									<option value="any" <%= user && user.congestion_alert === 'any' ? 'selected' : '' %>>모든 변화 알림</option>
									<option value="uncrowded" <%= user && user.congestion_alert === 'uncrowded' ? 'selected' : '' %>>여유 → 한산해졌을 때만</option>
									<option value="crowded" <%= user && user.congestion_alert === 'crowded' ? 'selected' : '' %>>혼잡 알림만</option>
									<option value="off" <%= user && user.congestion_alert === 'off' ? 'selected' : '' %>>알림 끔</option>
								</select>
							</div>

							<div class="mb-3">
								<label class="form-label small fw-bold">알림 시간대</label>
								<div class="input-group input-group-sm">
									<input type="time" class="form-control" name="notify_start" value="<%= user ? user.notify_start : '08:00' %>">
									<span class="input-group-text">~</span>
									<input type="time" class="form-control" name="notify_end" value="<%= user ? user.notify_end : '22:00' %>">
								</div>
							</div>

							<hr>

							<div class="form-check form-switch mb-2">
								<input class="form-check-input" type="checkbox" id="alertMeeting" name="alert_meeting" <%= user && user.alert_meeting ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertMeeting">내 모임 참여 요청 알림</label>
							</div>
							<div class="form-check form-switch mb-2">
								<input class="form-check-input" type="checkbox" id="alertComment" name="alert_comment" <%= user && user.alert_comment ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertComment">댓글·반응 알림</label>
							</div>
							<div class="form-check form-switch mb-2">
								<input class="form-check-input" type="checkbox" id="alertBadge" name="alert_badge" <%= user && user.alert_badge ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertBadge">배지 획득 알림</label>
							</div>
							<div class="form-check form-switch mb-3">
								<input class="form-check-input" type="checkbox" id="alertMarketing" name="alert_marketing" <%= user && user.alert_marketing ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertMarketing">이벤트·마케팅 알림</label>
							</div>

							<button type="submit" class="btn btn-brand w-100">저장</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</main>

    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		// 전체 선택 기능
		const selectAllCheck = document.getElementById('selectAllNoti');
		const notiChecks = document.querySelectorAll('.noti-checkbox');

		if (selectAllCheck) {
			selectAllCheck.addEventListener('change', function() {
				notiChecks.forEach(check => {
					check.checked = this.checked;
				});
			});
		}

		// 선택된 알림 ID들 가져오기
		function getSelectedIds() {
			const selected = [];
			document.querySelectorAll('.noti-checkbox:checked').forEach(check => {
				selected.push(check.value);
			});
			return selected;
		}

		// 읽음 처리
		async function markAsRead() {
			const ids = getSelectedIds();
			if (ids.length === 0) return alert('선택된 알림이 없습니다.');

			try {
				const response = await fetch('/member/notifications/read', {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ ids })
				});
				const result = await response.json();
				if (result.success) location.reload();
				else alert('처리에 실패했습니다.');
			} catch (error) {
				console.error(error);
				alert('오류가 발생했습니다.');
			}
		}

		// 선택 삭제
		async function deleteSelected() {
			const ids = getSelectedIds();
			if (ids.length === 0) return alert('선택된 알림이 없습니다.');
			if (!confirm('선택한 알림을 삭제하시겠습니까?')) return;

			try {
				const response = await fetch('/member/notifications', {
					method: 'DELETE',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ ids })
				});
				const result = await response.json();
				if (result.success) location.reload();
				else alert('삭제에 실패했습니다.');
			} catch (error) {
				console.error(error);
				alert('오류가 발생했습니다.');
			}
		}

		// 현재 페이지 읽은 알림 전체 삭제
		async function deletePageRead() {
			const readIds = [];
			document.querySelectorAll('.list-group-item[data-read="true"]').forEach(item => {
				readIds.push(item.dataset.id);
			});

			if (readIds.length === 0) return alert('현재 페이지에 읽은 알림이 없습니다.');
			if (!confirm('현재 페이지의 읽은 알림을 모두 삭제하시겠습니까?')) return;

			try {
				const response = await fetch('/member/notifications/read', {
					method: 'DELETE',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ ids: readIds })
				});
				const result = await response.json();
				if (result.success) location.reload();
				else alert('삭제에 실패했습니다.');
			} catch (error) {
				console.error(error);
				alert('오류가 발생했습니다.');
			}
		}
	</script>
</body>
</html>
