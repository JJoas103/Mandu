<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= title %> - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<!-- 헤더 -->
    <%- include('../partials/header') %>

	<!-- 메인 -->
	<main class="container my-4">

		<a href="/member/info" class="text-decoration-none text-muted small mb-3 d-inline-block">← 마이페이지로</a>

		<h4 class="mb-4">⭐ 찜한 장소 · 알림 설정</h4>

		<div class="row g-3">

			<!-- 찜한 장소 목록 -->
			<div class="col-lg-8">
				<div class="card shadow-sm">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h6 class="card-title mb-0">찜한 장소</h6>
							<small class="text-muted">혼잡도 변화 시 알림</small>
						</div>

						<div class="text-center py-5 text-muted">
                            찜 한 장소가 없습니다. <br> 장소 탐색에서 마음에 드는 곳을 추가해 보세요!
                        </div>

						<div class="text-center mt-3">
							<a href="/" class="btn btn-outline-brand">+ 장소 찜하러 가기</a>
						</div>
					</div>
				</div>
			</div>

			<!-- 알림 설정 -->
			<div class="col-lg-4">
				<div class="card shadow-sm">
					<div class="card-body">
						<h6 class="card-title mb-3">🔔 알림 설정</h6>

						<form action="/member/notify-settings" method="post">

							<div class="mb-3">
								<label class="form-label small fw-bold">혼잡도 알림 조건</label>
								<select class="form-select form-select-sm" name="congestion_alert">
									<option value="any" <%= user && user.congestion_alert === 'any' ? 'selected' : '' %>>모든 변화 알림</option>
									<option value="uncrowded" <%= user && user.congestion_alert === 'uncrowded' ? 'selected' : '' %>>여유 → 한산해졌을 때만</option>
									<option value="crowded" <%= user && user.congestion_alert === 'crowded' ? 'selected' : '' %>>혼잡 알림만</option>
									<option value="off" <%= user && user.congestion_alert === 'off' ? 'selected' : '' %>>알림 끔</option>
								</select>
							</div>

							<div class="mb-3">
								<label class="form-label small fw-bold">알림 시간대</label>
								<div class="input-group input-group-sm">
									<input type="time" class="form-control" name="notify_start" value="<%= user ? user.notify_start : '08:00' %>">
									<span class="input-group-text">~</span>
									<input type="time" class="form-control" name="notify_end" value="<%= user ? user.notify_end : '22:00' %>">
								</div>
							</div>

							<hr>

							<div class="form-check form-switch mb-2">
								<input class="form-check-input" type="checkbox" id="alertMeeting" name="alert_meeting" <%= user && user.alert_meeting ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertMeeting">내 모임 참여 요청 알림</label>
							</div>
							<div class="form-check form-switch mb-2">
								<input class="form-check-input" type="checkbox" id="alertComment" name="alert_comment" <%= user && user.alert_comment ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertComment">댓글·반응 알림</label>
							</div>
							<div class="form-check form-switch mb-2">
								<input class="form-check-input" type="checkbox" id="alertBadge" name="alert_badge" <%= user && user.alert_badge ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertBadge">배지 획득 알림</label>
							</div>
							<div class="form-check form-switch mb-3">
								<input class="form-check-input" type="checkbox" id="alertMarketing" name="alert_marketing" <%= user && user.alert_marketing ? 'checked' : '' %>>
								<label class="form-check-label small" for="alertMarketing">이벤트·마케팅 알림</label>
							</div>

							<button type="submit" class="btn btn-brand w-100">저장</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</main>

    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
