<!doctype html>
<html lang="ko">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>로그인 - 모여봄</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/style.css" rel="stylesheet">
</head>
<body>

	<%- include('../partials/header') %>

	<main class="container my-4">
		<div class="row justify-content-center">
			<div class="col-md-6 col-lg-5">
				<div class="card shadow-sm">
					<div class="card-body p-4">
						<div class="text-center mb-4">
							<div style="font-size:48px;">🌿</div>
							<h4 class="mt-2">모여봄 로그인</h4>
							<p class="text-muted small">모임 만들기·참여·제보 시 로그인이 필요합니다</p>
						</div>

						<form action="/member/login" method="post">
							<% if(locals.errorMessage) { %>
								<div class="alert alert-danger py-2 small"><%= errorMessage %></div>
							<% } %>

							<div class="mb-3">
								<label for="member_email" class="form-label">이메일</label>
								<input type="email" class="form-control" name="email" id="member_email" placeholder="이메일을 입력하세요" required>
							</div>
							<div class="mb-3">
								<label for="member_pass" class="form-label">비밀번호</label>
								<input type="password" class="form-control" name="password" id="member_pass" placeholder="비밀번호를 입력하세요" required>
							</div>

							<div class="d-grid gap-2 mb-4">
								<button type="submit" class="btn btn-brand btn-lg">로그인</button>
							</div>
                            
                            <div class="d-grid gap-2 mb-3">
                                <a href="/auth/google" class="btn btn-outline-danger">Google로 로그인</a>
                                <a href="/auth/naver" class="btn btn-success">네이버로 로그인</a>
                            </div>

                            <hr class="my-3">

							<div class="text-center small">
								<span class="text-muted">아직 회원이 아니신가요?</span>
								<a href="/member/join" class="text-decoration-none fw-bold" style="color:var(--brand);">회원가입</a>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</main>

    <%- include('../partials/footer') %>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
